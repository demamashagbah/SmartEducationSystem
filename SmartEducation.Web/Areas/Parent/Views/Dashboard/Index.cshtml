@{
    ViewData["Title"] = "Parent Dashboard";
    Layout = "~/Areas/Parent/Views/Shared/_ParentLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="fw-bold py-3 mb-0">
            <span class="text-muted fw-light">Parent /</span> Dashboard
        </h4>
        <p class="text-muted">Welcome, <strong>@ViewBag.ParentName</strong>. Monitor your children's academic progress.</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="me-3 bg-primary bg-opacity-10 rounded-3 p-3 d-flex align-items-center justify-content-center" style="width:60px;height:60px">
                    <i class="bx bx-user-circle text-primary fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">My Children</small>
                    <h3 class="mb-0 fw-bold">@ViewBag.ChildrenCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0">
        <h5 class="mb-0 fw-bold">Parent Portal</h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">Track your children's academic performance, attendance, and receive notifications.</p>
        <div class="alert alert-info border-0">
            <i class="bx bx-info-circle me-2"></i>
            <strong>Getting Started:</strong> Contact the school administrator to link your account to your children's profiles.
        </div>
    </div>
</div>
