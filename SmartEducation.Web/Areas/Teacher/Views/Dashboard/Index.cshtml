@model SmartEducation.Application.DTOs.TeacherDashboardDto
@{
    ViewData["Title"] = "Teacher Dashboard";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
}

<style>
    .kpi-card { border-radius: 16px; border: none; transition: transform .2s; }
    .kpi-card:hover { transform: translateY(-4px); }
    .kpi-icon { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; }
    .progress { height: 8px; border-radius: 4px; }
    .risk-badge-high { background: #fde8e8; color: #c0392b; padding: .3rem .7rem; border-radius: 50px; }
    .risk-badge-medium { background: #fef3cd; color: #856404; padding: .3rem .7rem; border-radius: 50px; }
    .risk-badge-low { background: #d4edda; color: #155724; padding: .3rem .7rem; border-radius: 50px; }
</style>

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1">Teacher Dashboard</h4>
            <p class="text-muted mb-0">Welcome, <strong>@Model.TeacherName</strong> &bull; ID: @Model.EmployeeNumber</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Teacher" asp-controller="LessonPlan" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bx bx-plus me-1"></i> New Lesson Plan
            </a>
            <a asp-area="Teacher" asp-controller="Message" asp-action="Index" class="btn btn-outline-secondary btn-sm position-relative">
                <i class="bx bx-envelope me-1"></i> Messages
                @if (Model.UnreadMessages > 0) {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@Model.UnreadMessages</span>
                }
            </a>
        </div>
    </div>
</div>

<!-- KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-xl col-md-4 col-6">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="kpi-icon" style="background:#696cff22"><i class="bx bx-buildings" style="color:#696cff;font-size:1.3rem"></i></div>
                    <small class="text-muted fw-semibold">Classes</small>
                </div>
                <h3 class="fw-bold mb-0" style="color:#696cff">@Model.AssignedClasses</h3>
                <small class="text-muted">Assigned</small>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-4 col-6">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="kpi-icon" style="background:#71dd3722"><i class="bx bx-book-open" style="color:#71dd37;font-size:1.3rem"></i></div>
                    <small class="text-muted fw-semibold">Subjects</small>
                </div>
                <h3 class="fw-bold mb-0" style="color:#71dd37">@Model.AssignedSubjects</h3>
                <small class="text-muted">Teaching</small>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-4 col-6">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="kpi-icon" style="background:#fd7e1422"><i class="bx bx-group" style="color:#fd7e14;font-size:1.3rem"></i></div>
                    <small class="text-muted fw-semibold">Students</small>
                </div>
                <h3 class="fw-bold mb-0" style="color:#fd7e14">@Model.TotalStudents</h3>
                <small class="text-muted">Total enrolled</small>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-4 col-6">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="kpi-icon" style="background:#e74c3c22"><i class="bx bx-file" style="color:#e74c3c;font-size:1.3rem"></i></div>
                    <small class="text-muted fw-semibold">Upcoming Exams</small>
                </div>
                <h3 class="fw-bold mb-0" style="color:#e74c3c">@Model.UpcomingExams</h3>
                <small class="text-muted">Scheduled</small>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-4 col-6">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="kpi-icon" style="background:#20c99722"><i class="bx bx-task" style="color:#20c997;font-size:1.3rem"></i></div>
                    <small class="text-muted fw-semibold">Assignments</small>
                </div>
                <h3 class="fw-bold mb-0" style="color:#20c997">@Model.PendingAssignments</h3>
                <small class="text-muted">Active</small>
            </div>
        </div>
    </div>
    <div class="col-xl col-md-4 col-6">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="kpi-icon" style="background:#9b59b622"><i class="bx bx-trophy" style="color:#9b59b6;font-size:1.3rem"></i></div>
                    <small class="text-muted fw-semibold">Success Rate</small>
                </div>
                <h3 class="fw-bold mb-0" style="color:#9b59b6">@Model.LearningOutcomeMastery.ToString("F0")%</h3>
                <small class="text-muted">Outcome mastery</small>
            </div>
        </div>
    </div>
</div>

<!-- Progress Indicators -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <h6 class="fw-bold mb-0">Curriculum Coverage</h6>
                <span class="badge @(Model.CurriculumCoverage >= 80 ? "bg-success" : Model.CurriculumCoverage >= 50 ? "bg-warning" : "bg-danger")">@Model.CurriculumCoverage.ToString("F1")%</span>
            </div>
            <div class="progress mb-2">
                <div class="progress-bar @(Model.CurriculumCoverage >= 80 ? "bg-success" : "bg-warning")" style="width:@Math.Min(100,Model.CurriculumCoverage)%"></div>
            </div>
            <small class="text-muted">@Model.LessonPlansCount plans created</small>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <h6 class="fw-bold mb-0">Attendance Rate</h6>
                <span class="badge @(Model.AttendanceRate >= 90 ? "bg-success" : "bg-warning")">@Model.AttendanceRate.ToString("F1")%</span>
            </div>
            <div class="progress mb-2">
                <div class="progress-bar bg-primary" style="width:@Model.AttendanceRate%"></div>
            </div>
            <small class="text-muted">Across all classes</small>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <h6 class="fw-bold mb-0">Outcome Mastery</h6>
                <span class="badge @(Model.LearningOutcomeMastery >= 80 ? "bg-success" : "bg-warning")">@Model.LearningOutcomeMastery.ToString("F1")%</span>
            </div>
            <div class="progress mb-2">
                <div class="progress-bar bg-info" style="width:@Model.LearningOutcomeMastery%"></div>
            </div>
            <small class="text-muted">Learning outcome mastery</small>
        </div></div>
    </div>
</div>

<!-- Classes + Subject Coverage -->
<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0">
                <h6 class="fw-bold mb-0"><i class="bx bx-buildings me-2 text-primary"></i>My Classes</h6>
            </div>
            <div class="card-body pt-0">
                @if (!Model.Classes.Any()) {
                    <div class="text-center py-4 text-muted"><i class="bx bx-buildings fs-1 d-block mb-2"></i>No classes assigned yet.</div>
                }
                @foreach (var cls in Model.Classes) {
                    <div class="d-flex align-items-center justify-content-between p-3 mb-2 rounded-3" style="background:#f8f9ff">
                        <div>
                            <span class="fw-bold d-block">@cls.ClassName</span>
                            <small class="text-muted">@cls.GradeName &bull; @cls.StudentCount students</small>
                            <div class="mt-1">
                                @foreach (var s in cls.Subjects.Take(3)) { <span class="badge bg-label-primary me-1">@s</span> }
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-success">@cls.AveragePerformance.ToString("F0")%</div>
                            <small class="text-muted">avg</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between">
                <h6 class="fw-bold mb-0"><i class="bx bx-bar-chart-alt-2 me-2 text-success"></i>Subject Coverage</h6>
                <a asp-area="Teacher" asp-controller="LessonPlan" asp-action="Create" class="btn btn-success btn-sm"><i class="bx bx-plus me-1"></i>Add Plan</a>
            </div>
            <div class="card-body pt-0">
                @if (!Model.SubjectCoverage.Any()) {
                    <div class="text-center py-4 text-muted"><i class="bx bx-book-open fs-1 d-block mb-2"></i>No subjects assigned yet.</div>
                }
                @foreach (var cov in Model.SubjectCoverage) {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold">@cov.SubjectName</span>
                            <small class="text-muted">@cov.PlannedLessons/@cov.TotalLessons lessons &bull; <strong>@cov.CoveragePercent.ToString("F0")%</strong></small>
                        </div>
                        <div class="progress">
                            <div class="progress-bar @(cov.CoveragePercent >= 80 ? "bg-success" : cov.CoveragePercent >= 50 ? "bg-warning" : "bg-danger")" style="width:@Math.Min(100,cov.CoveragePercent)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Students Overview -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 d-flex justify-content-between">
        <h6 class="fw-bold mb-0"><i class="bx bx-group me-2 text-warning"></i>Students Overview</h6>
        <a asp-area="Teacher" asp-controller="Students" asp-action="Index" class="btn btn-outline-primary btn-sm">View All Students</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentStudentActivity.Any()) {
            <div class="text-center py-5 text-muted"><i class="bx bx-group fs-1 d-block mb-2"></i>No students yet.</div>
        } else {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Student</th><th>Class</th><th>Avg Score</th><th>Attendance</th><th>Risk</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentStudentActivity) {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:34px;height:34px">
                                            <span class="text-primary fw-bold small">@s.StudentName.Substring(0,1)</span>
                                        </div>
                                        <span class="fw-semibold">@s.StudentName</span>
                                    </div>
                                </td>
                                <td>@s.ClassName</td>
                                <td><span class="fw-bold @(s.AverageScore >= 70 ? "text-success" : s.AverageScore >= 50 ? "text-warning" : "text-danger")">@(s.AverageScore > 0 ? s.AverageScore.ToString("F1")+"%" : "N/A")</span></td>
                                <td>@s.AttendanceRate.ToString("F0")%</td>
                                <td><span class="risk-badge-@s.RiskLevel.ToLower()">@s.RiskLevel</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Quick Actions -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0"><h6 class="fw-bold mb-0"><i class="bx bx-zap me-2"></i>Quick Actions</h6></div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Teacher" asp-controller="CurriculumPlan" asp-action="Generate" class="btn btn-primary">
                <i class="bx bx-brain me-1"></i>Generate Curriculum Plan
            </a>
            <a asp-area="Teacher" asp-controller="Attendance" asp-action="Create" class="btn btn-success">
                <i class="bx bx-user-check me-1"></i>Take Attendance
            </a>
            <a asp-area="Teacher" asp-controller="Assignment" asp-action="Create" class="btn btn-warning">
                <i class="bx bx-task me-1"></i>Create Assignment
            </a>
            <a asp-area="Teacher" asp-controller="Exam" asp-action="Create" class="btn btn-danger text-white">
                <i class="bx bx-file-blank me-1"></i>Create Exam
            </a>
            <a asp-area="Teacher" asp-controller="StudentAnalytics" asp-action="Index" class="btn btn-info text-white">
                <i class="bx bx-bar-chart-alt-2 me-1"></i>Student Analytics
            </a>
            <a asp-area="Teacher" asp-controller="CurriculumProgress" asp-action="Index" class="btn btn-outline-primary">
                <i class="bx bx-trending-up me-1"></i>Curriculum Progress
            </a>
            <a asp-area="Teacher" asp-controller="Message" asp-action="Compose" class="btn btn-outline-secondary">
                <i class="bx bx-send me-1"></i>Send Message
            </a>
        </div>
    </div>
</div>
