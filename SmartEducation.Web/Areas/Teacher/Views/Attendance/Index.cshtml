@model IEnumerable<SmartEducation.Application.DTOs.AttendanceSessionDto>
@{
    ViewData["Title"] = "Attendance";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Attendance Management</h4>
            <p class="text-muted mb-0">Track and manage student attendance for your classes.</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bx bx-plus me-1"></i> Take Attendance
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-user-check fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No attendance sessions yet</h5>
            <p class="text-muted">Start by taking attendance for your class.</p>
            <a asp-action="Create" class="btn btn-success"><i class="bx bx-plus me-1"></i>Take Attendance</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Subject</th>
                            <th>Class</th>
                            <th>Total</th>
                            <th>Present</th>
                            <th>Absent</th>
                            <th>Rate</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            var rate = s.TotalStudents > 0 ? (s.PresentCount * 100.0 / s.TotalStudents) : 0;
                            <tr>
                                <td><span class="fw-semibold">@s.SessionDate.ToString("MMM dd, yyyy")</span></td>
                                <td><span class="badge bg-label-primary">@s.SubjectName</span></td>
                                <td>@s.ClassRoomName</td>
                                <td>@s.TotalStudents</td>
                                <td><span class="text-success fw-bold">@s.PresentCount</span></td>
                                <td><span class="text-danger fw-bold">@s.AbsentCount</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:6px;min-width:60px">
                                            <div class="progress-bar @(rate >= 90 ? "bg-success" : rate >= 75 ? "bg-warning" : "bg-danger")"
                                                 style="width:@rate%"></div>
                                        </div>
                                        <small class="fw-bold @(rate >= 90 ? "text-success" : rate >= 75 ? "text-warning" : "text-danger")">
                                            @rate.ToString("F0")%
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    <a asp-action="MarkAttendance" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bx bx-edit-alt me-1"></i>Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
