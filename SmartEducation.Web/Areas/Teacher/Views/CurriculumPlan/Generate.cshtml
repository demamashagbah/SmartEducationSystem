@model SmartEducation.Application.DTOs.GenerateCurriculumPlanRequest
@{
    ViewData["Title"] = "Generate Curriculum Plan";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1"><i class="bx bx-brain me-2" style="color:#696cff"></i>AI Curriculum Plan Generator</h4>
            <p class="text-muted mb-0">Select your class and subject — AI will automatically generate a complete curriculum plan.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bx bx-arrow-back me-1"></i>Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="fw-bold mb-0"><i class="bx bx-cog me-2 text-primary"></i>Plan Configuration</h6>
            </div>
            <div class="card-body">
                <form asp-action="Generate" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject & Class <span class="text-danger">*</span></label>
                        <select asp-for="TeacherAssignmentId" asp-items="ViewBag.TeacherAssignments" class="form-select">
                            <option value="">— Select Subject / Class —</option>
                        </select>
                        <span asp-validation-for="TeacherAssignmentId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Plan Type <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            @{
                                var planTypes = new[] {
                                    ("Weekly", "Weekly Plan", "bx-calendar-week", "Covers lessons for the current week", "#696cff"),
                                    ("Monthly", "Monthly Plan", "bx-calendar", "Covers lessons for the entire month", "#71dd37"),
                                    ("Semester", "Semester Plan", "bx-calendar-alt", "Full semester coverage (4 months)", "#fd7e14")
                                };
                            }
                            @foreach (var (value, label, icon, desc, color) in planTypes)
                            {
                                <div class="col-md-4">
                                    <div class="form-check plan-type-card p-0 h-100">
                                        @{var isChecked = Model.PlanType == value;}
                                        <input class="form-check-input d-none" type="radio" name="PlanType"
                                               value="@value" id="pt_@value"
                                               checked="@isChecked" />
                                        <label class="form-check-label d-block p-3 rounded-3 border h-100 cursor-pointer plan-type-option"
                                               for="pt_@value" style="cursor:pointer">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bx @icon" style="color:@color;font-size:1.3rem"></i>
                                                <span class="fw-semibold">@label</span>
                                            </div>
                                            <small class="text-muted">@desc</small>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LessonsPerWeek" class="form-label fw-semibold">Lessons Per Week</label>
                            <select asp-for="LessonsPerWeek" class="form-select">
                                <option value="1">1 lesson / week</option>
                                <option value="2" selected>2 lessons / week</option>
                                <option value="3">3 lessons / week</option>
                                <option value="4">4 lessons / week</option>
                                <option value="5">5 lessons / week</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Notes" class="form-label fw-semibold">Additional Notes (optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"
                                  placeholder="Any special instructions or notes for this plan..."></textarea>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bx bx-brain me-2"></i>Generate AI Curriculum Plan
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4" style="background:linear-gradient(135deg,#696cff22,#71dd3722)">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bx bx-brain me-2" style="color:#696cff"></i>How AI Plan Generation Works</h6>
                <div class="d-flex gap-2 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:28px;height:28px;background:#696cff;color:white;font-weight:700;font-size:.75rem">1</div>
                    <div>
                        <div class="fw-semibold small">Load Curriculum Structure</div>
                        <small class="text-muted">AI reads all Units, Lessons, Topics and Learning Outcomes for your subject.</small>
                    </div>
                </div>
                <div class="d-flex gap-2 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:28px;height:28px;background:#71dd37;color:white;font-weight:700;font-size:.75rem">2</div>
                    <div>
                        <div class="fw-semibold small">Sequence Lessons</div>
                        <small class="text-muted">Lessons are scheduled across your selected time period based on the curriculum order.</small>
                    </div>
                </div>
                <div class="d-flex gap-2 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:28px;height:28px;background:#fd7e14;color:white;font-weight:700;font-size:.75rem">3</div>
                    <div>
                        <div class="fw-semibold small">Generate Content</div>
                        <small class="text-muted">For each lesson: teaching strategy, activities, homework and learning outcomes are generated.</small>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:28px;height:28px;background:#20c997;color:white;font-weight:700;font-size:.75rem">4</div>
                    <div>
                        <div class="fw-semibold small">Track Progress</div>
                        <small class="text-muted">Mark lessons as completed as you teach, and track curriculum coverage automatically.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-2"><i class="bx bx-info-circle text-info me-1"></i>Prerequisites</h6>
                <ul class="list-unstyled small text-muted mb-0">
                    <li class="mb-2"><i class="bx bx-check text-success me-1"></i>Subject must have Units created</li>
                    <li class="mb-2"><i class="bx bx-check text-success me-1"></i>Units must have Lessons</li>
                    <li class="mb-2"><i class="bx bx-info-circle text-info me-1"></i>Topics and Learning Outcomes enhance the plan quality</li>
                    <li><i class="bx bx-info-circle text-info me-1"></i>You can edit any generated content after creation</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('input[name="PlanType"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
        document.querySelectorAll('.plan-type-option').forEach(function(lbl) {
            lbl.style.borderColor = '';
            lbl.style.background = '';
        });
        var selectedLabel = document.querySelector('label[for="' + this.id + '"]');
        selectedLabel.style.borderColor = '#696cff';
        selectedLabel.style.background = '#696cff11';
    });
    // Init
    if (radio.checked) {
        var lbl = document.querySelector('label[for="' + radio.id + '"]');
        lbl.style.borderColor = '#696cff';
        lbl.style.background = '#696cff11';
    }
});
</script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
