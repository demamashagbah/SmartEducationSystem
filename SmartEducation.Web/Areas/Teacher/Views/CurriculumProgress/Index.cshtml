@using SmartEducation.Web.Areas.Teacher.Controllers
@model List<SubjectProgressViewModel>
@{
    ViewData["Title"] = "Curriculum Progress";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
    double overallAvg = Model.Any() ? Math.Round(Model.Average(s => s.CoveragePercent), 1) : 0;
    int totalLessons = Model.Sum(s => s.TotalLessons);
    int completedLessons = Model.Sum(s => s.CompletedLessons);
}

<style>
    .progress { height: 10px; border-radius: 5px; }
    .lesson-dot-done { width:10px;height:10px;border-radius:50%;background:#71dd37;display:inline-block }
    .lesson-dot-pending { width:10px;height:10px;border-radius:50%;background:#e0e0e0;display:inline-block }
    .unit-collapse-btn { cursor:pointer; user-select:none; }
    .unit-collapse-btn:hover { color: #696cff; }
</style>

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="bx bx-trending-up text-primary me-2"></i>Curriculum Progress</h4>
            <p class="text-muted mb-0">Track your planned vs completed lessons across all subjects.</p>
        </div>
        <a asp-area="Teacher" asp-controller="CurriculumPlan" asp-action="Generate" class="btn btn-primary btn-sm">
            <i class="bx bx-brain me-1"></i> Generate Plan
        </a>
    </div>
</div>

<!-- Overview KPIs -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
            <h2 class="fw-bold text-primary mb-0">@overallAvg%</h2>
            <small class="text-muted">Overall Coverage</small>
            <div class="progress mt-2">
                <div class="progress-bar bg-primary" style="width:@overallAvg%"></div>
            </div>
        </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
            <h2 class="fw-bold text-success mb-0">@completedLessons</h2>
            <small class="text-muted">Lessons Completed</small>
        </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
            <h2 class="fw-bold text-warning mb-0">@(totalLessons - completedLessons)</h2>
            <small class="text-muted">Remaining Lessons</small>
        </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
            <h2 class="fw-bold text-info mb-0">@Model.Count</h2>
            <small class="text-muted">Active Subjects</small>
        </div></div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-book-open fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No curriculum data available</h5>
            <p class="text-muted small">No subjects or lessons found. Generate a curriculum plan to start tracking progress.</p>
            <a asp-area="Teacher" asp-controller="CurriculumPlan" asp-action="Generate" class="btn btn-primary">
                <i class="bx bx-brain me-1"></i> Generate Curriculum Plan
            </a>
        </div>
    </div>
}

@foreach (var subject in Model)
{
    var sbColor = subject.CoveragePercent >= 80 ? "success"
                : subject.CoveragePercent >= 50 ? "warning" : "danger";
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:44px;height:44px;background:#696cff22">
                        <i class="bx bx-book-open text-primary fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">@subject.SubjectName</h5>
                        <small class="text-muted">@subject.TotalUnits units &bull; @subject.TotalLessons lessons &bull; @subject.CompletedLessons completed</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div style="min-width:160px">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted">Coverage</small>
                            <small class="fw-bold text-@sbColor">@subject.CoveragePercent%</small>
                        </div>
                        <div class="progress">
                            <div class="progress-bar bg-@sbColor" style="width:@subject.CoveragePercent%"></div>
                        </div>
                    </div>
                    <span class="badge bg-label-@sbColor fs-6">@subject.CoveragePercent%</span>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @foreach (var unit in subject.Units)
            {
                var uColor = unit.CoveragePercent >= 80 ? "success"
                           : unit.CoveragePercent >= 50 ? "warning" : "danger";
                var collapseId = $"unit-{unit.UnitId:N}";
                <div class="border-bottom">
                    <div class="d-flex align-items-center justify-content-between px-4 py-3 unit-collapse-btn"
                         data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bx bx-cube text-primary"></i>
                            <div>
                                <span class="fw-semibold">@unit.UnitName</span>
                                <small class="text-muted ms-2">@unit.CompletedLessons/@unit.TotalLessons lessons</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div style="min-width:120px">
                                <div class="progress" style="height:6px">
                                    <div class="progress-bar bg-@uColor" style="width:@unit.CoveragePercent%"></div>
                                </div>
                            </div>
                            <span class="badge bg-label-@uColor">@unit.CoveragePercent%</span>
                            <i class="bx bx-chevron-down text-muted"></i>
                        </div>
                    </div>

                    <div class="collapse" id="@collapseId">
                        <div class="px-5 pb-3">
                            <div class="row g-2">
                                @foreach (var lesson in unit.Lessons)
                                {
                                    <div class="col-md-4 col-6">
                                        <div class="d-flex align-items-center gap-2 p-2 rounded-2"
                                             style="background:@(lesson.IsCompleted ? "#f0fff4" : "#f8f9fa")">
                                            @if (lesson.IsCompleted)
                                            {
                                                <i class="bx bx-check-circle text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bx bx-circle text-muted"></i>
                                            }
                                            <span class="small @(lesson.IsCompleted ? "fw-semibold text-success" : "text-muted")">
                                                @lesson.LessonName
                                            </span>
                                        </div>
                                    </div>
                                }
                                @if (!unit.Lessons.Any())
                                {
                                    <div class="col-12">
                                        <p class="text-muted small mb-0"><i class="bx bx-info-circle me-1"></i>No lessons defined for this unit yet.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (!subject.Units.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bx bx-cube fs-2 d-block mb-2"></i>
                    <small>No units found for this subject. Upload a Teacher Guide to populate curriculum structure.</small>
                </div>
            }
        </div>
    </div>
}
