@using SmartEducation.Web.Areas.Teacher.Controllers
@using SmartEducation.Domain.Entities
@model List<QuestionBank>
@{
    ViewData["Title"] = "Question Bank";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
    var subjectDict = ViewBag.SubjectDict as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="bx bx-question-mark text-primary me-2"></i>Question Bank</h4>
            <p class="text-muted mb-0">Manage your reusable question library — @Model.Count questions.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i>Add Question</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Filters -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <select name="subjectId" class="form-select form-select-sm" style="max-width:180px">
                <option value="">All Subjects</option>
                @foreach (var s in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Subjects)
                {
                    <option value="@s.Value" selected="@(ViewBag.SubjectFilter?.ToString() == s.Value ? "selected" : null)">@s.Text</option>
                }
            </select>
            <select name="questionType" class="form-select form-select-sm" style="max-width:180px">
                <option value="">All Types</option>
                @foreach (var t in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.QuestionTypes)
                {
                    <option value="@t.Value" selected="@(ViewBag.QuestionTypeFilter == t.Value ? "selected" : null)">@t.Text</option>
                }
            </select>
            <select name="difficulty" class="form-select form-select-sm" style="max-width:160px">
                <option value="">All Difficulties</option>
                @foreach (var d in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Difficulties)
                {
                    <option value="@d.Value" selected="@(ViewBag.DifficultyFilter == d.Value ? "selected" : null)">@d.Text</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bx bx-filter me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bx bx-x me-1"></i>Clear</a>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-question-mark fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No questions yet</h5>
            <p class="text-muted">Add questions manually or generate them via the AI exam generator.</p>
            <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i>Add First Question</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px">#</th>
                        <th>Question</th>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Difficulty</th>
                        <th>Marks</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var q in Model)
                    {
                        var typeColor = q.QuestionType.ToString() switch {
                            "MultipleChoice" => "primary",
                            "TrueFalse"      => "info",
                            "Essay"          => "warning",
                            "FillInTheBlank" => "success",
                            _                => "secondary"
                        };
                        var diffColor = q.DifficultyLevel.ToString() switch {
                            "Easy"   => "success",
                            "Hard"   => "danger",
                            _        => "warning"
                        };
                        <tr>
                            <td class="text-muted small">@i++</td>
                            <td>
                                <div class="fw-semibold" style="max-width:320px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"
                                     title="@q.QuestionText">@q.QuestionText</div>
                                @if (!string.IsNullOrEmpty(q.CorrectAnswer))
                                {
                                    <small class="text-muted"><i class="bx bx-check text-success me-1"></i>Answer: @q.CorrectAnswer</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-label-primary">
                                    @(subjectDict.TryGetValue(q.SubjectId, out var sn) ? sn : "Unknown")
                                </span>
                            </td>
                            <td><span class="badge bg-label-@typeColor">@q.QuestionType</span></td>
                            <td><span class="badge bg-label-@diffColor">@q.DifficultyLevel</span></td>
                            <td><span class="badge bg-label-secondary">@q.Marks mk</span></td>
                            <td class="text-end pe-3">
                                <form asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this question?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
