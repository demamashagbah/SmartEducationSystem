@model IEnumerable<SmartEducation.Application.DTOs.AssignmentDto>
@{
    ViewData["Title"] = "Assignments";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Assignments</h4>
            <p class="text-muted mb-0">Create and manage assignments for your classes.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="GenerateAI" class="btn btn-outline-primary">
                <i class="bx bx-brain me-1"></i> AI Generate
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bx bx-plus me-1"></i> Manual Create
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-task fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No assignments yet</h5>
            <p class="text-muted">Create your first assignment to get started.</p>
            <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i>Create Assignment</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Subject</th>
                            <th>Class</th>
                            <th>Due Date</th>
                            <th>Max Score</th>
                            <th>Submissions</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            var isOverdue = a.DueDate < DateTime.Now;
                            var daysLeft = (a.DueDate - DateTime.Now).Days;
                            <tr>
                                <td>
                                    <span class="fw-semibold">@a.Title</span>
                                    @if (!string.IsNullOrEmpty(a.Description))
                                    {
                                        <br /><small class="text-muted">@(a.Description.Length > 60 ? a.Description.Substring(0, 60) + "..." : a.Description)</small>
                                    }
                                </td>
                                <td><span class="badge bg-label-primary">@a.SubjectName</span></td>
                                <td>@a.ClassRoomName</td>
                                <td>
                                    <span class="@(isOverdue ? "text-danger" : daysLeft <= 3 ? "text-warning" : "text-success") fw-semibold">
                                        @a.DueDate.ToString("MMM dd, yyyy")
                                    </span>
                                    @if (!isOverdue)
                                    {
                                        <br /><small class="text-muted">@daysLeft day(s) left</small>
                                    }
                                    else
                                    {
                                        <br /><small class="text-danger">Overdue</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@a.MaxScore pts</span></td>
                                <td>
                                    <a asp-action="Submissions" asp-route-id="@a.Id" class="text-primary fw-bold">
                                        @a.SubmissionCount <small class="text-muted fw-normal">submitted</small>
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Submissions" asp-route-id="@a.Id" class="btn btn-sm btn-outline-info" title="View Submissions">
                                            <i class="bx bx-list-ul"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@a.Id" method="post"
                                              onsubmit="return confirm('Delete assignment: @a.Title?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bx bx-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
