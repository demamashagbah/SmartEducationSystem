@{
    ViewData["Title"] = "Assignment Submissions";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
    var assignment = (SmartEducation.Application.DTOs.AssignmentDto)ViewBag.Assignment;
    var submissions = ViewBag.Submissions as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1">Submissions: @assignment.Title</h4>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-label-primary">@assignment.SubjectName</span>
                <span class="badge bg-label-secondary">Due: @assignment.DueDate.ToString("MMM dd, yyyy")</span>
                <span class="badge bg-label-info">Max: @assignment.MaxScore pts</span>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bx bx-arrow-back me-1"></i>Back</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card border-0 shadow-sm">
    @if (!submissions.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bx bx-inbox fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No submissions yet</h5>
            <p class="text-muted">Students have not submitted this assignment.</p>
        </div>
    }
    else
    {
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Submitted</th>
                            <th>Notes</th>
                            <th>Grade</th>
                            <th>Feedback</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in submissions)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:34px;height:34px">
                                            <span class="text-primary fw-bold small">@s.StudentName.Substring(0,1)</span>
                                        </div>
                                        <span class="fw-semibold">@s.StudentName</span>
                                    </div>
                                </td>
                                <td><small>@s.SubmittedAt.ToString("MMM dd, HH:mm")</small></td>
                                <td><small class="text-muted">@(s.Notes ?? "—")</small></td>
                                <td>
                                    @if (s.Grade != null)
                                    {
                                        <span class="badge @(s.Grade >= 80 ? "bg-success" : s.Grade >= 60 ? "bg-warning" : "bg-danger")">
                                            @s.Grade / @assignment.MaxScore
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-secondary">Not graded</span>
                                    }
                                </td>
                                <td><small class="text-muted">@(s.Feedback ?? "—")</small></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal"
                                            data-bs-target="#gradeModal-@s.SubmissionId">
                                        <i class="bx bx-edit-alt me-1"></i>Grade
                                    </button>

                                    <div class="modal fade" id="gradeModal-@s.SubmissionId" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form asp-action="GradeSubmission" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="submissionId" value="@s.SubmissionId" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Grade: @s.StudentName</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Grade (out of @assignment.MaxScore)</label>
                                                            <input type="number" name="grade" class="form-control"
                                                                   min="0" max="@assignment.MaxScore"
                                                                   value="@s.Grade" placeholder="Enter grade" />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Feedback</label>
                                                            <textarea name="feedback" class="form-control" rows="3"
                                                                      placeholder="Optional feedback for the student...">@s.Feedback</textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary">Save Grade</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
