@using SmartEducation.Domain.Entities
@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
    int unreadCount = Model.Count(n => !n.IsRead);
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="bx bx-bell text-primary me-2"></i>Notifications
                @if (unreadCount > 0)
                {
                    <span class="badge bg-danger ms-2">@unreadCount new</span>
                }
            </h4>
            <p class="text-muted mb-0">@Model.Count total notifications.</p>
        </div>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bx bx-check-double me-1"></i>Mark All Read
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-bell-off fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No notifications</h5>
            <p class="text-muted">You're all caught up! Notifications will appear here.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="list-group list-group-flush">
            @foreach (var n in Model)
            {
                <div class="list-group-item list-group-item-action d-flex align-items-start gap-3 py-3 px-4
                             @(!n.IsRead ? "border-start border-primary border-3" : "")">
                    <div class="flex-shrink-0 mt-1">
                        @if (!n.IsRead)
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:36px;height:36px;background:#696cff22">
                                <i class="bx bx-bell text-primary"></i>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:36px;height:36px;background:#f0f0f0">
                                <i class="bx bx-bell text-muted"></i>
                            </div>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold @(!n.IsRead ? "text-dark" : "text-muted")">@n.Title</span>
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="btn btn-sm btn-link p-0 text-muted" title="Mark as read">
                                        <i class="bx bx-check"></i>
                                    </button>
                                </form>
                            }
                        </div>
                        <p class="mb-0 small text-muted mt-1">@n.Message</p>
                    </div>
                </div>
            }
        </div>
    </div>
}
