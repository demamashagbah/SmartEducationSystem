@using SmartEducation.Web.Areas.Teacher.Controllers
@model List<StudentAnalyticsViewModel>
@{
    ViewData["Title"] = "Student Analytics";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";

    var highRisk   = Model.Where(s => s.RiskLevel == "High").ToList();
    var mediumRisk = Model.Where(s => s.RiskLevel == "Medium").ToList();
    var lowRisk    = Model.Where(s => s.RiskLevel == "Low").ToList();
    double successRate = Model.Count > 0
        ? Math.Round(Model.Count(s => s.AverageScore >= 60) / (double)Model.Count * 100, 1) : 0;
}

<style>
    .risk-high   { background:#fde8e8; color:#c0392b; border:1px solid #f5c2c7; }
    .risk-medium { background:#fff3cd; color:#856404; border:1px solid #ffecb5; }
    .risk-low    { background:#d1e7dd; color:#0f5132; border:1px solid #badbcc; }
    .score-bar   { height:6px; border-radius:3px; }
    .stat-icon   { width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center; }
</style>

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="bx bx-bar-chart-alt-2 text-primary me-2"></i>Student Analytics</h4>
            <p class="text-muted mb-0">Performance overview across all your classes — @Model.Count students total.</p>
        </div>
    </div>
</div>

<!-- Summary KPIs -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm"><div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#696cff22"><i class="bx bx-group" style="color:#696cff;font-size:1.4rem"></i></div>
            <div><small class="text-muted d-block">Total Students</small><h3 class="fw-bold mb-0" style="color:#696cff">@Model.Count</h3></div>
        </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm"><div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#71dd3722"><i class="bx bx-trophy" style="color:#71dd37;font-size:1.4rem"></i></div>
            <div><small class="text-muted d-block">Success Rate</small><h3 class="fw-bold mb-0" style="color:#71dd37">@successRate%</h3></div>
        </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm"><div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#fd7e1422"><i class="bx bx-error-circle" style="color:#fd7e14;font-size:1.4rem"></i></div>
            <div><small class="text-muted d-block">At Risk</small><h3 class="fw-bold mb-0" style="color:#fd7e14">@highRisk.Count</h3></div>
        </div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm"><div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#20c99722"><i class="bx bx-user-check" style="color:#20c997;font-size:1.4rem"></i></div>
            <div><small class="text-muted d-block">Performing Well</small><h3 class="fw-bold mb-0" style="color:#20c997">@lowRisk.Count</h3></div>
        </div></div>
    </div>
</div>

@if (highRisk.Any())
{
    <div class="card border-0 shadow-sm mb-4" style="border-left:4px solid #dc3545!important">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 py-3">
            <i class="bx bx-error-circle text-danger fs-5"></i>
            <h6 class="fw-bold text-danger mb-0">At-Risk Students — Immediate Attention Required (@highRisk.Count)</h6>
        </div>
        <div class="card-body pt-0">
            @await Html.PartialAsync("_StudentAnalyticsTable", highRisk)
        </div>
    </div>
}

@if (mediumRisk.Any())
{
    <div class="card border-0 shadow-sm mb-4" style="border-left:4px solid #fd7e14!important">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 py-3">
            <i class="bx bx-info-circle text-warning fs-5"></i>
            <h6 class="fw-bold text-warning mb-0">Average Students — Needs Monitoring (@mediumRisk.Count)</h6>
        </div>
        <div class="card-body pt-0">
            @await Html.PartialAsync("_StudentAnalyticsTable", mediumRisk)
        </div>
    </div>
}

@if (lowRisk.Any())
{
    <div class="card border-0 shadow-sm mb-4" style="border-left:4px solid #71dd37!important">
        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 py-3">
            <i class="bx bx-check-circle text-success fs-5"></i>
            <h6 class="fw-bold text-success mb-0">High Performing Students (@lowRisk.Count)</h6>
        </div>
        <div class="card-body pt-0">
            @await Html.PartialAsync("_StudentAnalyticsTable", lowRisk)
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-bar-chart-alt-2 fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No students found</h5>
            <p class="text-muted">Students will appear here once they are assigned to your classes.</p>
        </div>
    </div>
}
