@model IEnumerable<SmartEducation.Application.DTOs.LessonPlanDto>
@{
    ViewData["Title"] = "Lesson Plans";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Lesson Plans</h4>
            <p class="text-muted mb-0">Plan, track, and manage your lesson delivery.</p>
        </div>
        <a asp-area="Teacher" asp-controller="LessonPlan" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Create Lesson Plan
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bx bx-notepad fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No lesson plans yet</h5>
            <p class="text-muted">Start by creating your first lesson plan.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bx bx-plus me-1"></i> Create First Lesson Plan
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var plan in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h6 class="fw-bold mb-1">@plan.Title</h6>
                                <div class="d-flex gap-1 flex-wrap">
                                    <span class="badge bg-label-primary">@plan.SubjectName</span>
                                    <span class="badge bg-label-info">@plan.ClassRoomName</span>
                                </div>
                            </div>
                            <span class="badge @(plan.IsAiGenerated ? "bg-label-warning" : "bg-label-secondary")">
                                @(plan.IsAiGenerated ? "AI Generated" : "Manual")
                            </span>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-flex align-items-center gap-1 mb-1">
                                <i class="bx bx-calendar"></i>
                                @plan.LessonDate.ToString("MMM dd, yyyy")
                            </small>
                            <small class="text-muted d-flex align-items-center gap-1 mb-1">
                                <i class="bx bx-time"></i>
                                @plan.DurationMinutes minutes
                            </small>
                            @if (plan.LessonName != null)
                            {
                                <small class="text-muted d-flex align-items-center gap-1">
                                    <i class="bx bx-book-reader"></i>
                                    @plan.LessonName
                                </small>
                            }
                        </div>
                        <div class="mb-3">
                            <small class="fw-semibold text-muted d-block mb-1">Objectives:</small>
                            <small class="text-muted">@(plan.Objectives.Length > 100 ? plan.Objectives.Substring(0, 100) + "..." : plan.Objectives)</small>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0">
                        <div class="d-flex gap-2">
                            <a asp-action="View" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-info flex-grow-1">
                                <i class="bx bx-show me-1"></i> View Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-sm btn-primary">
                                <i class="bx bx-edit-alt me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@plan.Id" method="post"
                                  onsubmit="return confirm('Delete this lesson plan?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bx bx-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
