@model SmartEducation.Application.DTOs.LessonPlanDto
@{
    ViewData["Title"] = "Create Lesson Plan";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Create Lesson Plan</h4>
            <p class="text-muted mb-0">Design a structured lesson plan for your class.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bx bx-arrow-back me-1"></i> Back to Plans
        </a>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0">
                    <h6 class="fw-bold mb-0"><i class="bx bx-info-circle me-2 text-primary"></i>Basic Information</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Plan Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g., Introduction to Photosynthesis" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TeacherAssignmentId" class="form-label fw-semibold">Subject & Class <span class="text-danger">*</span></label>
                            <select asp-for="TeacherAssignmentId" asp-items="ViewBag.TeacherAssignments" class="form-select">
                                <option value="">— Select Subject / Class —</option>
                            </select>
                            <span asp-validation-for="TeacherAssignmentId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LessonId" class="form-label fw-semibold">Linked Lesson</label>
                            <select asp-for="LessonId" asp-items="ViewBag.Lessons" class="form-select">
                                <option value="">— Optional —</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label asp-for="LessonDate" class="form-label fw-semibold">Lesson Date <span class="text-danger">*</span></label>
                            <input asp-for="LessonDate" type="date" class="form-control" />
                            <span asp-validation-for="LessonDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold">Duration (minutes)</label>
                            <input asp-for="DurationMinutes" type="number" class="form-control" min="15" max="240" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0">
                    <h6 class="fw-bold mb-0"><i class="bx bx-target-lock me-2 text-success"></i>Learning Objectives & Content</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Objectives" class="form-label fw-semibold">Learning Objectives <span class="text-danger">*</span></label>
                        <textarea asp-for="Objectives" class="form-control" rows="3" placeholder="By the end of this lesson, students will be able to..."></textarea>
                        <span asp-validation-for="Objectives" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Introduction" class="form-label fw-semibold">Introduction / Warm-Up</label>
                        <textarea asp-for="Introduction" class="form-control" rows="2" placeholder="How will you introduce the topic?"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Activities" class="form-label fw-semibold">Activities <span class="text-danger">*</span></label>
                        <textarea asp-for="Activities" class="form-control" rows="4" placeholder="Describe the main classroom activities..."></textarea>
                        <span asp-validation-for="Activities" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0">
                    <h6 class="fw-bold mb-0"><i class="bx bx-cog me-2 text-warning"></i>Teaching Methods & Assessment</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="TeachingStrategies" class="form-label fw-semibold">Teaching Strategies</label>
                        <textarea asp-for="TeachingStrategies" class="form-control" rows="2" placeholder="e.g., Direct instruction, group work, think-pair-share..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AssessmentMethods" class="form-label fw-semibold">Assessment Methods</label>
                        <textarea asp-for="AssessmentMethods" class="form-control" rows="2" placeholder="e.g., Exit tickets, quiz, observation, project..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Homework" class="form-label fw-semibold">Homework / Follow-up</label>
                        <textarea asp-for="Homework" class="form-control" rows="2" placeholder="Any homework or follow-up tasks..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Actions</h6>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> Save Lesson Plan
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-2"><i class="bx bx-bulb text-warning me-1"></i>Planning Tips</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><i class="bx bx-check text-success me-1"></i>Start with clear learning objectives</li>
                        <li class="mb-2"><i class="bx bx-check text-success me-1"></i>Align activities to objectives</li>
                        <li class="mb-2"><i class="bx bx-check text-success me-1"></i>Include varied teaching strategies</li>
                        <li class="mb-2"><i class="bx bx-check text-success me-1"></i>Plan formative assessment checkpoints</li>
                        <li><i class="bx bx-check text-success me-1"></i>Link to curriculum lesson for tracking</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
