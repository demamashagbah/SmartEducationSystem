@{
    ViewData["Title"] = "Settings";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="fw-bold mb-1"><i class="bx bx-cog text-primary me-2"></i>Settings</h4>
        <p class="text-muted mb-0">Manage your account preferences.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bx bx-cog fs-1 text-muted d-block mb-3" style="animation:spin 4s linear infinite"></i>
                <h5 class="text-muted">Settings Coming Soon</h5>
                <p class="text-muted">Account preferences and notification settings will be available in the next update.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-area="Teacher" asp-controller="Profile" asp-action="Edit" class="btn btn-primary">
                        <i class="bx bx-edit me-1"></i> Edit Profile
                    </a>
                    <a asp-area="Teacher" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bx bx-home me-1"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
@@keyframes spin { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }
</style>
}
