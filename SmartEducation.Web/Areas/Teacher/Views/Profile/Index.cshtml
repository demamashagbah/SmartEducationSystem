@using SmartEducation.Web.Areas.Teacher.Controllers
@model TeacherProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Areas/Teacher/Views/shared/_TeacherLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="bx bx-user-circle text-primary me-2"></i>My Profile</h4>
            <p class="text-muted mb-0">Your teacher account information and assignments.</p>
        </div>
        <a asp-action="Edit" class="btn btn-primary btn-sm"><i class="bx bx-edit me-1"></i>Edit Profile</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-4">
    <!-- Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-5">
                <div class="rounded-circle bg-success bg-opacity-15 d-flex align-items-center justify-content-center mx-auto mb-3"
                     style="width:90px;height:90px">
                    <span class="fw-bold text-success" style="font-size:2.2rem">
                        @(Model.FirstName.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "T")
                    </span>
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted mb-2">@(string.IsNullOrEmpty(Model.Specialization) ? "Teacher" : Model.Specialization)</p>
                <code class="small">@Model.EmployeeNumber</code>
                <div class="mt-3 d-flex justify-content-center gap-3">
                    <div>
                        <div class="fw-bold text-primary">@Model.AssignedClasses.Count</div>
                        <small class="text-muted">Classes</small>
                    </div>
                    <div class="border-start px-3">
                        <div class="fw-bold text-success">@Model.AssignedSubjects.Count</div>
                        <small class="text-muted">Subjects</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-0">
                <h6 class="fw-bold mb-0"><i class="bx bx-id-card text-primary me-2"></i>Personal Information</h6>
            </div>
            <div class="card-body pt-0">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small d-block">First Name</label>
                        <span class="fw-semibold">@Model.FirstName</span>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small d-block">Last Name</label>
                        <span class="fw-semibold">@Model.LastName</span>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small d-block">Email</label>
                        <span class="fw-semibold">@Model.Email</span>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small d-block">Employee Number</label>
                        <code>@Model.EmployeeNumber</code>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small d-block">Specialization</label>
                        <span class="fw-semibold">@(Model.Specialization ?? "—")</span>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small d-block">Qualification</label>
                        <span class="fw-semibold">@(Model.Qualification ?? "—")</span>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small d-block">Years of Experience</label>
                        <span class="fw-semibold">@(Model.YearsOfExperience.HasValue ? Model.YearsOfExperience + " years" : "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assignments -->
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="fw-bold mb-0"><i class="bx bx-book-open text-success me-2"></i>Assigned Subjects</h6>
                    </div>
                    <div class="card-body pt-0">
                        @if (Model.AssignedSubjects.Any())
                        {
                            @foreach (var s in Model.AssignedSubjects)
                            {
                                <span class="badge bg-label-success me-1 mb-1">@s</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No subjects assigned yet.</span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="fw-bold mb-0"><i class="bx bx-buildings text-primary me-2"></i>Assigned Classes</h6>
                    </div>
                    <div class="card-body pt-0">
                        @if (Model.AssignedClasses.Any())
                        {
                            @foreach (var c in Model.AssignedClasses)
                            {
                                <span class="badge bg-label-primary me-1 mb-1">@c</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No classes assigned yet.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
