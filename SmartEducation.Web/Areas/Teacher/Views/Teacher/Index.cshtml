@model IEnumerable<SmartEducation.Application.DTOs.TeacherClassDto>
@{
    // Updated path to reflect the new Area structure
    Layout = "~/Areas/Teacher/Views/Shared/_TeacherLayout.cshtml";
}
<!-- Welcome Header Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card bg-label-primary border-0 shadow-sm">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
                <div>
                    <h4 class="fw-bold mb-1 text-primary">Assigned Classes & Subjects</h4>
                    <p class="mb-0 text-muted">Welcome to your adaptive workspace. Manage your current courses, lessons, and track student outcomes seamlessly.</p>
                </div>
                <div class="avatar avatar-md bg-primary rounded p-2 d-none d-md-block">
                    <i class="bx bx-book-open text-white fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Grid System for Assigned Course Cards -->
<div class="row">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center my-5">
            <div class="text-muted fs-4">No assigned classes or subjects were found for your profile.</div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm border-0 position-relative class-card-hover" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                    
                    <!-- Card Top Meta Info -->
                    <div class="card-header d-flex justify-content-between align-items-center bg-transparent border-0 pb-0">
                        <span class="badge bg-label-success rounded-pill px-3 py-2 fw-semibold">
                            <i class="bx bx-calendar-event me-1"></i> @item.WeeklyLessonsCount Lessons / Week
                        </span>
                        <div class="dropdown">
                            <button class="btn p-0" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="bx bx-dots-vertical-rounded fs-4 text-muted"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-menu-item dropdown-item" href="#"><i class="bx bx-info-circle me-1"></i> View Curriculum Details</a>
                            </div>
                        </div>
                    </div>

                    <!-- Main Core Meta Body -->
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center mb-3">
                            <div class="avatar flex-shrink-0 me-3 bg-label-primary p-2 rounded">
                                <i class="bx bx-layer fs-3 text-primary"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0 text-dark">@item.GradeName</h5>
                                <small class="text-muted">Section: <span class="fw-bold text-secondary">@item.ClassName</span></small>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded mb-2 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <i class="bx bx-book text-warning me-2 fs-4"></i>
                                <span class="fw-semibold text-body">Subject:</span>
                            </div>
                            <span class="fw-bold text-dark">@item.SubjectName</span>
                        </div>
                    </div>

                    <!-- Fast Operational Action Buttons -->
                    <div class="card-footer bg-transparent border-0 pt-0 d-grid gap-2">
                        <div class="row g-2">
                            <div class="col-6">
                                <a href="#" class="btn btn-outline-primary btn-sm w-100 py-2">
                                    <i class="bx bx-user-check me-1"></i> Attendance
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="#" class="btn btn-outline-secondary btn-sm w-100 py-2">
                                    <i class="bx bx-calendar-edit me-1"></i> Lesson Plan
                                </a>
                            </div>
                        </div>
                        <a href="#" class="btn btn-primary btn-md w-100 py-2 mt-1">
                            <i class="bx bx-navigation me-1"></i> Class Workspace
                        </a>
                    </div>

                </div>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        .class-card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
        }
    </style>
}