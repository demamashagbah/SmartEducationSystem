@model SmartEducation.Application.DTOs.LessonDto
@{
    ViewData["Title"] = "Add Lesson";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="fw-bold py-3 mb-0"><span class="text-muted fw-light">Lessons /</span> Add Lesson</h4>
    </div>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Unit</label>
                        <select asp-for="UnitId" class="form-select form-select-lg">
                            <option value="">-- Select Unit --</option>
                            @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Units)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold">Lesson Name</label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g., Lesson 1 - Basic Concepts" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bx bx-save me-1"></i> Save
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
