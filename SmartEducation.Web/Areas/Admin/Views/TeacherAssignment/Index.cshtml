@model IEnumerable<SmartEducation.Application.DTOs.TeacherAssignmentDetailDto>
@{
    ViewData["Title"] = "Teacher Assignments";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Teacher Assignments</h4>
            <p class="text-muted mb-0">Overview of which teacher teaches which subject in which class.</p>
        </div>
        <a asp-action="Assign" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Assign Teacher
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Teacher Name</th>
                    <th>Assigned Class</th>
                    <th>Assigned Subject</th>
                    <th>Academic Year</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bx bx-user-voice fs-1 d-block mb-2"></i>
                            No teacher assignments yet.
                            <a asp-action="Assign">Assign the first teacher.</a>
                        </td>
                    </tr>
                }
                @{ int i = 1; }
                @foreach (var a in Model)
                {
                    <tr class="@(a.IsActive ? "" : "table-secondary opacity-75")">
                        <td>@i++</td>
                        <td>
                            <div class="fw-semibold">@a.TeacherName</div>
                            <small class="text-muted">@a.TeacherEmail</small>
                        </td>
                        <td>
                            <span class="badge bg-label-primary">@a.ClassRoomName</span>
                        </td>
                        <td>
                            <span class="badge bg-label-success">@a.SubjectName</span>
                        </td>
                        <td>@(string.IsNullOrEmpty(a.AcademicYearName) ? "—" : a.AcademicYearName)</td>
                        <td>
                            @if (a.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="col-actions">
                            <div class="action-btns">
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit"
                                            class="btn-action @(a.IsActive ? "btn-action-deactivate" : "btn-action-activate")"
                                            data-bs-toggle="tooltip"
                                            title="@(a.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bx @(a.IsActive ? "bx-pause-circle" : "bx-play-circle")"></i>
                                        <span>@(a.IsActive ? "Deactivate" : "Activate")</span>
                                    </button>
                                </form>
                                <form asp-action="Remove" method="post" class="d-inline"
                                      onsubmit="return confirm('Remove this teacher assignment?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit" class="btn-action btn-action-delete"
                                            data-bs-toggle="tooltip" title="Remove Assignment">
                                        <i class="bx bx-trash"></i><span>Remove</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
