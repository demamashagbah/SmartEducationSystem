@model SmartEducation.Web.Areas.Admin.Models.TeacherAssignmentViewModel
@{
    ViewData["Title"] = "Assign Teacher";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="text-muted text-decoration-none">Teacher Assignments</a>
            <span class="text-muted">/</span>
            <span>Assign Teacher</span>
        </div>
        <h4 class="fw-bold">Assign Teacher to Subject</h4>
        <p class="text-muted">Link a teacher to a specific subject within a class.</p>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Assign" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="mb-3">
                <label asp-for="TeacherId" class="form-label fw-semibold">Teacher *</label>
                <select asp-for="TeacherId" asp-items="Model.TeacherOptions" class="form-select form-select-lg">
                    <option value="">Select Teacher...</option>
                </select>
                <span asp-validation-for="TeacherId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ClassRoomId" class="form-label fw-semibold">Class *</label>
                <select asp-for="ClassRoomId" asp-items="Model.ClassRoomOptions" class="form-select form-select-lg"
                        id="classRoomSelect">
                    <option value="">Select Class...</option>
                </select>
                <span asp-validation-for="ClassRoomId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SubjectId" class="form-label fw-semibold">Subject *</label>
                <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-select form-select-lg"
                        id="subjectSelect">
                    <option value="">Select Class first...</option>
                </select>
                <span asp-validation-for="SubjectId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="AcademicYearId" class="form-label fw-semibold">Academic Year</label>
                <select asp-for="AcademicYearId" asp-items="Model.AcademicYearOptions" class="form-select">
                    <option value="">Select Year (optional)...</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bx bx-link me-1"></i> Assign Teacher
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('classRoomSelect').addEventListener('change', function () {
            const classRoomId = this.value;
            const subjectSelect = document.getElementById('subjectSelect');
            subjectSelect.innerHTML = '<option value="">Loading...</option>';

            if (!classRoomId) {
                subjectSelect.innerHTML = '<option value="">Select Class first...</option>';
                return;
            }

            fetch(`/Admin/TeacherAssignment/GetSubjectsForClass?classRoomId=${classRoomId}`)
                .then(r => r.json())
                .then(data => {
                    subjectSelect.innerHTML = '<option value="">Select Subject...</option>';
                    data.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.value;
                        opt.textContent = s.text;
                        subjectSelect.appendChild(opt);
                    });
                });
        });
    </script>
}
