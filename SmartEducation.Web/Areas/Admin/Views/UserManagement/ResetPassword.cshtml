@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    var userId = (Guid)ViewBag.UserId;
    var userName = ViewBag.UserName as string;
    var userRole = ViewBag.UserRole as string;
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="text-muted text-decoration-none">Users</a>
            <span class="text-muted">/</span>
            <span>Reset Password</span>
        </div>
        <h4 class="fw-bold">Reset Password</h4>
        <p class="text-muted">Set a new password for <strong>@userName</strong> <span class="badge bg-label-info">@userRole</span></p>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:420px">
    <div class="card-body">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["Error"]</div>
        }
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@userId" />

            <div class="mb-4">
                <label class="form-label fw-semibold">New Password *</label>
                <input type="password" name="newPassword" class="form-control form-control-lg"
                       placeholder="Enter new password" minlength="6" required />
                <div class="form-text">Minimum 6 characters.</div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bx bx-lock-open me-1"></i> Reset Password
                </button>
            </div>
        </form>
    </div>
</div>
