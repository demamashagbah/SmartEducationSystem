@{
    ViewData["Title"] = "Reset Student Password";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    var studentName = ViewBag.StudentName as string;
    var userId = (Guid)ViewBag.UserId;
}

<div class="row mb-4">
    <div class="col-12">
        <a asp-action="Index" class="text-muted text-decoration-none small"><i class="bx bx-arrow-back me-1"></i>Students</a>
        <h4 class="fw-bold mt-1">Reset Password</h4>
        <p class="text-muted">Set a new password for <strong>@studentName</strong>.</p>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:420px">
    <div class="card-body">
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@userId" />
            <div class="mb-4">
                <label class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                <input type="password" name="newPassword" class="form-control form-control-lg" minlength="6" required placeholder="Min 6 characters" />
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bx bx-lock-open me-1"></i>Reset Password
                </button>
            </div>
        </form>
    </div>
</div>
