@model IEnumerable<SmartEducation.Application.DTOs.AcademicYearDto>
@{
    ViewData["Title"] = "Academic Years";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Academic Years</h4>
            <p class="text-muted mb-0">Manage academic year schedules.</p>
        </div>
        <a asp-area="Admin" asp-controller="AcademicYear" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add Academic Year
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Year Name</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            No academic years found. <a asp-action="Create">Add the first one.</a>
                        </td>
                    </tr>
                }
                @{ int i = 1; }
                @foreach (var year in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td><span class="fw-semibold">@year.Name</span></td>
                        <td>@year.StartDate.ToString("MMM dd, yyyy")</td>
                        <td>@year.EndDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (year.IsActive)
                            {
                                <span class="badge bg-label-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-label-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@year.Id" class="btn btn-sm btn-primary me-1">
                                <i class="bx bx-edit-alt me-1"></i> Edit Year
                            </a>
                            <form asp-action="Delete" asp-route-id="@year.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this academic year?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bx bx-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
