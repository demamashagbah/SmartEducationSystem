@model IEnumerable<SmartEducation.Application.DTOs.ExamDto>
@{
    ViewData["Title"] = "Exams";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Exams</h4>
            <p class="text-muted mb-0">Manage all school examinations.</p>
        </div>
        <a asp-area="Admin" asp-controller="Exam" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Create Exam
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Marks</th>
                    <th>Questions</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bx bx-file fs-1 d-block mb-2"></i>
                            No exams found. <a asp-action="Create">Create the first one.</a>
                        </td>
                    </tr>
                }
                @{ int i = 1; }
                @foreach (var exam in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td><span class="fw-semibold">@exam.Title</span></td>
                        <td>@exam.SubjectName</td>
                        <td>
                            @{
                                var typeClass = exam.ExamType.ToString() switch
                                {
                                    "Final" => "bg-label-danger",
                                    "Midterm" => "bg-label-warning",
                                    "Quiz" => "bg-label-info",
                                    _ => "bg-label-secondary"
                                };
                            }
                            <span class="badge @typeClass">@exam.ExamType</span>
                        </td>
                        <td>@exam.ExamDate.ToString("MMM dd, yyyy")</td>
                        <td>@exam.TotalMarks pts</td>
                        <td>@exam.QuestionCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@exam.Id" class="btn btn-sm btn-primary me-1">
                                <i class="bx bx-edit-alt me-1"></i> Edit Exam
                            </a>
                            <form asp-action="Delete" asp-route-id="@exam.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this exam?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bx bx-trash me-1"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
