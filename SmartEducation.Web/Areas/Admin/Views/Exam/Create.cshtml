@model SmartEducation.Application.DTOs.ExamDto
@{
    ViewData["Title"] = "Create Exam";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="fw-bold py-3 mb-0"><span class="text-muted fw-light">Exams /</span> Create Exam</h4>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row mb-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold">Exam Title</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g., Math Midterm Exam" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Subject</label>
                            <select asp-for="SubjectId" class="form-select">
                                <option value="">-- Select Subject --</option>
                                @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Subjects)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Classroom (Optional)</label>
                            <select asp-for="ClassRoomId" class="form-select">
                                <option value="">-- All Classrooms --</option>
                                @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ClassRooms)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Exam Type</label>
                            <select asp-for="ExamType" class="form-select">
                                @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ExamTypes)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExamDate" class="form-label fw-semibold">Exam Date</label>
                            <input asp-for="ExamDate" type="datetime-local" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="TotalMarks" class="form-label fw-semibold">Total Marks</label>
                            <input asp-for="TotalMarks" type="number" class="form-control" min="1" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold">Duration (min)</label>
                            <input asp-for="DurationMinutes" type="number" class="form-control" min="1" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Description (Optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bx bx-save me-1"></i> Create Exam
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
