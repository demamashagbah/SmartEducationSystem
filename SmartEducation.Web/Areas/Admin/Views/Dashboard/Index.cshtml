@model SmartEducation.Application.DTOs.Dashboard.DashboardStatisticsDto
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="fw-bold py-3 mb-0">
            <span class="text-muted fw-light">Smart Education /</span> Dashboard
        </h4>
    </div>
</div>

<!-- Educational Management Stats -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="avatar avatar-lg me-3 bg-primary bg-opacity-10 rounded-3 p-3">
                    <i class="bx bx-user-circle text-primary fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">Total Students</small>
                    <h3 class="mb-0 fw-bold">@Model.TotalStudents</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="avatar avatar-lg me-3 bg-success bg-opacity-10 rounded-3 p-3">
                    <i class="bx bx-chalkboard text-success fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">Total Teachers</small>
                    <h3 class="mb-0 fw-bold">@Model.TotalTeachers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="avatar avatar-lg me-3 bg-info bg-opacity-10 rounded-3 p-3">
                    <i class="bx bx-buildings text-info fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">Total Classes</small>
                    <h3 class="mb-0 fw-bold">@Model.TotalClassRooms</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="avatar avatar-lg me-3 bg-warning bg-opacity-10 rounded-3 p-3">
                    <i class="bx bx-book-open text-warning fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">Total Subjects</small>
                    <h3 class="mb-0 fw-bold">@Model.TotalSubjects</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Analytics Row -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="avatar avatar-lg me-3 bg-success bg-opacity-10 rounded-3 p-3">
                    <i class="bx bx-trending-up text-success fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">Student Success Rate</small>
                    <h3 class="mb-0 fw-bold">@Model.SuccessRate.ToString("F1")%</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="avatar avatar-lg me-3 bg-primary bg-opacity-10 rounded-3 p-3">
                    <i class="bx bx-check-circle text-primary fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">Attendance Rate</small>
                    <h3 class="mb-0 fw-bold">@Model.AttendanceRate.ToString("F1")%</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="avatar avatar-lg me-3 bg-danger bg-opacity-10 rounded-3 p-3">
                    <i class="bx bx-x-circle text-danger fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">Failure Rate</small>
                    <h3 class="mb-0 fw-bold">@((100 - Model.SuccessRate).ToString("F1"))%</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="avatar avatar-lg me-3 bg-warning bg-opacity-10 rounded-3 p-3">
                    <i class="bx bx-target-lock text-warning fs-3"></i>
                </div>
                <div>
                    <small class="text-muted d-block fw-semibold">Outcome Mastery</small>
                    <h3 class="mb-0 fw-bold">—</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row">
    <div class="col-12 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Quick Actions</h5>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Analytics"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bx bx-bar-chart-alt-2 me-1"></i> View Full Analytics
                </a>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-auto">
                        <a asp-area="Admin" asp-controller="ClassRoom" asp-action="Create"
                           class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> Create New Class
                        </a>
                    </div>
                    <div class="col-auto">
                        <a asp-area="Admin" asp-controller="ClassRoom" asp-action="Index"
                           class="btn btn-info text-white">
                            <i class="bx bx-buildings me-1"></i> Manage Classes
                        </a>
                    </div>
                    <div class="col-auto">
                        <a asp-area="Admin" asp-controller="TeacherAssignment" asp-action="Index"
                           class="btn btn-warning">
                            <i class="bx bx-link me-1"></i> Teacher Assignments
                        </a>
                    </div>
                    <div class="col-auto">
                        <a asp-area="Admin" asp-controller="UserManagement" asp-action="Create"
                           class="btn btn-success">
                            <i class="bx bx-user-plus me-1"></i> Add Teacher
                        </a>
                    </div>
                    <div class="col-auto">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Analytics"
                           class="btn btn-outline-secondary">
                            <i class="bx bx-bar-chart-alt-2 me-1"></i> School Analytics
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Workflow Guide -->
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm border-start border-primary border-4">
            <div class="card-body">
                <h6 class="fw-bold text-primary mb-3"><i class="bx bx-info-circle me-2"></i>Setup Workflow</h6>
                <div class="row g-2">
                    @{
                        var steps = new[]
                        {
                            ("1", "Create Classes (e.g. Grade 7, Grade 8)", "bx-buildings"),
                            ("2", "Add Students to each Class", "bx-user-plus"),
                            ("3", "Assign Subjects to each Class", "bx-book-add"),
                            ("4", "Assign Teachers to Subjects in each Class", "bx-chalkboard"),
                            ("5", "Upload Teacher Guides per Subject", "bx-upload"),
                            ("6", "AI extracts curriculum structure automatically", "bx-bot")
                        };
                    }
                    @foreach (var (num, text, icon) in steps)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary rounded-circle" style="width:24px;height:24px;display:flex;align-items:center;justify-content:center">@num</span>
                                <span class="small text-muted">@text</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
