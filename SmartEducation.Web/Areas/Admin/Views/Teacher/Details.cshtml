@model SmartEducation.Application.DTOs.TeacherDetailDto
@{
    ViewData["Title"] = "Teacher Details";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <a asp-action="Index" class="text-muted text-decoration-none small"><i class="bx bx-arrow-back me-1"></i>Teachers</a>
            <h4 class="fw-bold mt-1 mb-0">@Model.FullName</h4>
            <code class="text-muted">@Model.EmployeeNumber</code>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.ProfileId" class="btn btn-outline-primary">
                <i class="bx bx-edit me-1"></i> Edit Teacher
            </a>
            <a asp-action="ResetPassword" asp-route-id="@Model.ProfileId" class="btn btn-outline-secondary">
                <i class="bx bx-lock-open me-1"></i> Reset Password
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-success bg-opacity-10 border-0 py-3">
                <h6 class="fw-bold text-success mb-0"><i class="bx bx-user me-2"></i>Personal Information</h6>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0 small">
                    <tr><th class="text-muted fw-normal" style="width:45%">Full Name</th><td class="fw-semibold">@Model.FullName</td></tr>
                    <tr><th class="text-muted fw-normal">Email</th><td>@Model.Email</td></tr>
                    <tr><th class="text-muted fw-normal">Phone</th><td>@(Model.PhoneNumber ?? "—")</td></tr>
                    <tr><th class="text-muted fw-normal">Gender</th><td>@(Model.Gender ?? "—")</td></tr>
                    <tr><th class="text-muted fw-normal">Date of Birth</th><td>@Model.DateOfBirth?.ToString("dd MMM yyyy")</td></tr>
                    <tr><th class="text-muted fw-normal">Status</th>
                        <td>@if (Model.IsActive) { <span class="badge bg-label-success">Active</span> } else { <span class="badge bg-label-danger">Inactive</span> }</td></tr>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-warning bg-opacity-10 border-0 py-3">
                <h6 class="fw-bold text-warning mb-0"><i class="bx bx-chalkboard me-2"></i>Professional Information</h6>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0 small">
                    <tr><th class="text-muted fw-normal" style="width:45%">Employee No.</th><td><code>@Model.EmployeeNumber</code></td></tr>
                    <tr><th class="text-muted fw-normal">Username</th><td>@Model.Username</td></tr>
                    <tr><th class="text-muted fw-normal">Specialization</th><td>@(Model.Specialization ?? "—")</td></tr>
                    <tr><th class="text-muted fw-normal">Qualification</th><td>@(Model.Qualification ?? "—")</td></tr>
                    <tr><th class="text-muted fw-normal">Experience</th><td>@(Model.YearsOfExperience.HasValue ? $"{Model.YearsOfExperience} years" : "—")</td></tr>
                </table>
            </div>
        </div>
    </div>
    @if (Model.AssignedClassNames.Any() || Model.AssignedSubjectNames.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary bg-opacity-10 border-0 py-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bx bx-link me-2"></i>Assignments</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted small fw-semibold mb-2">ASSIGNED CLASSES (@Model.AssignedClassCount)</h6>
                            @foreach (var cn in Model.AssignedClassNames) { <span class="badge bg-label-primary me-1 mb-1">@cn</span> }
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted small fw-semibold mb-2">ASSIGNED SUBJECTS (@Model.AssignedSubjectCount)</h6>
                            @foreach (var sn in Model.AssignedSubjectNames) { <span class="badge bg-label-success me-1 mb-1">@sn</span> }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
