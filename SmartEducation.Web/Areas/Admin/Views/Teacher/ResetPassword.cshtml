@{
    ViewData["Title"] = "Reset Teacher Password";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    var name = ViewBag.TeacherName as string;
    var userId = (Guid)ViewBag.UserId;
}
<div class="row mb-4"><div class="col-12">
    <a asp-action="Index" class="text-muted text-decoration-none small"><i class="bx bx-arrow-back me-1"></i>Teachers</a>
    <h4 class="fw-bold mt-1">Reset Password</h4>
    <p class="text-muted">Set a new password for <strong>@name</strong>.</p>
</div></div>
<div class="card border-0 shadow-sm" style="max-width:420px">
    <div class="card-body">
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@userId" />
            <div class="mb-4">
                <label class="form-label fw-semibold">New Password *</label>
                <input type="password" name="newPassword" class="form-control form-control-lg" minlength="6" required />
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bx bx-lock-open me-1"></i>Reset Password
                </button>
            </div>
        </form>
    </div>
</div>
