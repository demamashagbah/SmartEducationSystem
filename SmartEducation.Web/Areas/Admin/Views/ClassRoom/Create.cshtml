@model SmartEducation.Web.Areas.Admin.Models.ClassRoomViewModel
@{
    ViewData["Title"] = "Create Class";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="text-muted text-decoration-none">Classes</a>
            <span class="text-muted">/</span>
            <span>Create Class</span>
        </div>
        <h4 class="fw-bold">Create New Class</h4>
        <p class="text-muted">Create a class (e.g. Grade 7A). After creation, you can add students, assign subjects, and assign teachers.</p>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:520px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Class Name *</label>
                <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g., Grade 7A, Grade 8B" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="GradeId" class="form-label fw-semibold">Grade *</label>
                <select asp-for="GradeId" asp-items="Model.GradeOptions" class="form-select form-select-lg">
                    <option value="">Select Grade...</option>
                </select>
                <span asp-validation-for="GradeId" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bx bx-plus me-1"></i> Create Class
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
