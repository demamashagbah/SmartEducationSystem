@{
    ViewData["Title"] = "Reset Student Password";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    var studentName = ViewBag.StudentName as string;
    var userId = (Guid)ViewBag.UserId;
    var classRoomId = (Guid)ViewBag.ClassRoomId;
}

<div class="row mb-4">
    <div class="col-12">
        <h4 class="fw-bold">Reset Password</h4>
        <p class="text-muted">Set a new password for <strong>@studentName</strong>.</p>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:420px">
    <div class="card-body">
        <form asp-action="ResetStudentPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@userId" />
            <input type="hidden" name="classRoomId" value="@classRoomId" />

            <div class="mb-4">
                <label class="form-label fw-semibold">New Password *</label>
                <input type="password" name="newPassword" class="form-control form-control-lg"
                       placeholder="Enter new password" minlength="6" required />
                <div class="form-text">Minimum 6 characters.</div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Manage" asp-route-id="@classRoomId" class="btn btn-outline-secondary flex-fill">Cancel</a>
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bx bx-lock-open me-1"></i> Reset Password
                </button>
            </div>
        </form>
    </div>
</div>
