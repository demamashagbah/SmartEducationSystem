@model SmartEducation.Application.DTOs.StudentDetailDto
@{
    ViewData["Title"] = "Student Details";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-muted text-decoration-none">Classes</a>
                <span class="text-muted">/</span>
                <a asp-action="Manage" asp-route-id="@Model.ClassRoomId" class="text-muted text-decoration-none">@Model.ClassRoomName</a>
                <span class="text-muted">/</span>
                <span>Student Details</span>
            </div>
            <h4 class="fw-bold mb-0">@Model.FullName</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="EditStudent" asp-route-profileId="@Model.ProfileId" class="btn btn-outline-primary">
                <i class="bx bx-edit me-1"></i> Edit
            </a>
            <a asp-action="ResetStudentPassword" asp-route-profileId="@Model.ProfileId" class="btn btn-outline-secondary">
                <i class="bx bx-lock-open me-1"></i> Reset Password
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pb-0">
                <h6 class="fw-bold text-primary mb-0"><i class="bx bx-user me-2"></i>Personal Information</h6>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><th class="text-muted fw-normal w-50">Full Name</th><td class="fw-semibold">@Model.FullName</td></tr>
                    <tr><th class="text-muted fw-normal">Student Number</th><td><code>@Model.StudentNumber</code></td></tr>
                    <tr><th class="text-muted fw-normal">National Number</th><td>@Model.NationalNumber</td></tr>
                    <tr><th class="text-muted fw-normal">Gender</th><td>@Model.Gender</td></tr>
                    <tr><th class="text-muted fw-normal">Date of Birth</th><td>@Model.DateOfBirth?.ToString("dd MMM yyyy")</td></tr>
                    <tr><th class="text-muted fw-normal">Status</th>
                        <td>@if (Model.IsActive) { <span class="badge bg-label-success">Active</span> } else { <span class="badge bg-label-danger">Inactive</span> }</td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pb-0">
                <h6 class="fw-bold text-success mb-0"><i class="bx bx-lock me-2"></i>Account</h6>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><th class="text-muted fw-normal w-50">Username</th><td>@Model.Username</td></tr>
                    <tr><th class="text-muted fw-normal">Email</th><td>@Model.Email</td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pb-0">
                <h6 class="fw-bold text-warning mb-0"><i class="bx bx-graduation me-2"></i>Academic Information</h6>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><th class="text-muted fw-normal w-50">Class</th><td class="fw-semibold">@Model.ClassRoomName</td></tr>
                    <tr><th class="text-muted fw-normal">Academic Year</th><td>@(string.IsNullOrEmpty(Model.AcademicYearName) ? "—" : Model.AcademicYearName)</td></tr>
                    <tr><th class="text-muted fw-normal">Enrollment Date</th><td>@Model.EnrollmentDate.ToString("dd MMM yyyy")</td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pb-0">
                <h6 class="fw-bold text-info mb-0"><i class="bx bx-user-check me-2"></i>Parent / Guardian</h6>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><th class="text-muted fw-normal w-50">Parent Name</th><td class="fw-semibold">@Model.ParentName</td></tr>
                    <tr><th class="text-muted fw-normal">Phone</th><td>@Model.ParentPhone</td></tr>
                    <tr><th class="text-muted fw-normal">Email</th><td>@Model.ParentEmail</td></tr>
                    <tr><th class="text-muted fw-normal">Address</th><td>@(Model.Address ?? "—")</td></tr>
                    <tr><th class="text-muted fw-normal">Emergency</th><td>@(Model.EmergencyContact ?? "—")</td></tr>
                </table>
            </div>
        </div>
    </div>
</div>
