@model SmartEducation.Web.Areas.Admin.Models.SubjectViewModel
@{
    ViewData["Title"] = "Add Subject";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="text-muted text-decoration-none">Classes</a>
            <span class="text-muted">/</span>
            <a asp-action="Manage" asp-route-id="@Model.ClassRoomId" class="text-muted text-decoration-none">@Model.ClassRoomName</a>
            <span class="text-muted">/</span>
            <span>Add Subject</span>
        </div>
        <h4 class="fw-bold">Add Subject to @Model.ClassRoomName</h4>
    </div>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px">
    <div class="card-body">
        <form asp-action="AssignSubject" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ClassRoomId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Subject Name *</label>
                <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Mathematics, Science, English" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Brief description of the subject..."></textarea>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Manage" asp-route-id="@Model.ClassRoomId" class="btn btn-outline-secondary flex-fill">Cancel</a>
                <button type="submit" class="btn btn-success flex-fill">
                    <i class="bx bx-plus me-1"></i> Add Subject
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
