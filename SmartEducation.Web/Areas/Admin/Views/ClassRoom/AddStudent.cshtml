@model SmartEducation.Web.Areas.Admin.Models.StudentViewModel
@{
    ViewData["Title"] = "Add Student";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center gap-2 mb-1 small text-muted">
            <a asp-action="Index">Classes</a>
            <span>/</span>
            <a asp-action="Manage" asp-route-id="@Model.ClassRoomId">@Model.ClassRoomName</a>
            <span>/</span>
            <span>Add Student</span>
        </div>
        <h4 class="fw-bold">Add Student to @Model.ClassRoomName</h4>
    </div>
</div>

<form asp-action="AddStudent" method="post" id="addStudentForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClassRoomId" />
    <input type="hidden" asp-for="LinkedParentProfileId" id="linkedParentProfileId" />
    <input type="hidden" asp-for="LinkedParentName" id="linkedParentName" />

    <div class="row g-4">

        <!-- Personal Information -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pb-0 pt-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bx bx-user me-2"></i>Personal Information</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">First Name *</label>
                            <input asp-for="FirstName" class="form-control" placeholder="Ahmad" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">Last Name *</label>
                            <input asp-for="LastName" class="form-control" placeholder="Al-Hassan" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StudentNumber" class="form-label fw-semibold">Student Number *</label>
                            <input asp-for="StudentNumber" class="form-control" placeholder="STU-2024-001" />
                            <span asp-validation-for="StudentNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NationalNumber" class="form-label fw-semibold">National Number *</label>
                            <input asp-for="NationalNumber" class="form-control" placeholder="1234567890" />
                            <span asp-validation-for="NationalNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold">Gender *</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold">Date of Birth *</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Credentials -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pb-0 pt-3">
                    <h6 class="fw-bold text-success mb-0"><i class="bx bx-lock me-2"></i>Account Credentials</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Username" class="form-label fw-semibold">Username *</label>
                            <input asp-for="Username" class="form-control" placeholder="ahmad.hassan" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label fw-semibold">Email *</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="student@school.edu" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Default: Student@123" />
                            <div class="form-text">Leave blank to use default password.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Academic Information -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pb-0 pt-3">
                    <h6 class="fw-bold text-warning mb-0"><i class="bx bx-graduation me-2"></i>Academic Information</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Assigned Class</label>
                            <input type="text" class="form-control bg-light" value="@Model.ClassRoomName" readonly />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AcademicYearId" class="form-label fw-semibold">Academic Year</label>
                            <select asp-for="AcademicYearId" asp-items="Model.AcademicYearOptions" class="form-select">
                                <option value="">Select Academic Year</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EnrollmentDate" class="form-label fw-semibold">Enrollment Date *</label>
                            <input asp-for="EnrollmentDate" type="date" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Parent / Guardian -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pb-0 pt-3 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold text-info mb-0"><i class="bx bx-user-check me-2"></i>Parent / Guardian</h6>
                    <!-- Toggle -->
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-info active" id="btnNewParent" onclick="setParentMode('new')">
                            <i class="bx bx-user-plus me-1"></i>New Parent
                        </button>
                        <button type="button" class="btn btn-outline-info" id="btnLinkParent" onclick="setParentMode('link')">
                            <i class="bx bx-link me-1"></i>Link Existing
                        </button>
                    </div>
                </div>
                <div class="card-body">

                    <!-- Mode: New Parent -->
                    <div id="panelNewParent">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="ParentName" class="form-label fw-semibold">Parent Name *</label>
                                <input asp-for="ParentName" class="form-control" placeholder="Mohammed Al-Hassan" />
                                <span asp-validation-for="ParentName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ParentPhone" class="form-label fw-semibold">Parent Phone *</label>
                                <input asp-for="ParentPhone" class="form-control" placeholder="+962 79 123 4567" />
                                <span asp-validation-for="ParentPhone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ParentEmail" class="form-label fw-semibold">Parent Email *</label>
                                <input asp-for="ParentEmail" type="email" class="form-control" placeholder="parent@email.com" />
                                <span asp-validation-for="ParentEmail" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="alert alert-light border mt-3 mb-0 py-2 small">
                            <i class="bx bx-info-circle text-info me-1"></i>
                            This stores parent contact details for reference. To link to an existing parent account, use <strong>Link Existing</strong>.
                        </div>
                    </div>

                    <!-- Mode: Link Existing Parent -->
                    <div id="panelLinkParent" style="display:none">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Search Existing Parent Account</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent"><i class="bx bx-search text-muted"></i></span>
                                <input type="text" id="parentSearchInput" class="form-control border-start-0"
                                       placeholder="Search by name, email, or phone…" autocomplete="off" />
                            </div>
                            <div id="parentSearchResults" class="list-group mt-2" style="max-height:240px;overflow-y:auto;display:none"></div>
                        </div>

                        <!-- Selected parent display -->
                        <div id="selectedParentCard" class="alert alert-info d-flex align-items-center gap-3 mb-0" style="display:none!important">
                            <div class="rounded-circle bg-info bg-opacity-20 d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:40px;height:40px">
                                <i class="bx bx-user text-info fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold" id="selectedParentNameDisplay"></div>
                                <small id="selectedParentEmailDisplay" class="text-muted"></small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearParentLink()">
                                <i class="bx bx-x"></i>
                            </button>
                        </div>

                        <div id="noParentSelected" class="alert alert-warning mb-0">
                            <i class="bx bx-info-circle me-1"></i>
                            No parent selected. Search and select a parent to link. Optionally proceed without linking.
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Optional Information -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pb-0 pt-3">
                    <h6 class="fw-bold text-secondary mb-0"><i class="bx bx-info-circle me-2"></i>Optional Information</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold">Address</label>
                            <input asp-for="Address" class="form-control" placeholder="123 Main St, City" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmergencyContact" class="form-label fw-semibold">Emergency Contact</label>
                            <input asp-for="EmergencyContact" class="form-control" placeholder="Name: +962 79 XXX XXXX" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 d-flex gap-2 justify-content-end">
            <a asp-action="Manage" asp-route-id="@Model.ClassRoomId" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bx bx-user-plus me-1"></i>Add Student
            </button>
        </div>

    </div>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    let parentMode = 'new';

    function setParentMode(mode) {
        parentMode = mode;
        if (mode === 'new') {
            $('#panelNewParent').show();
            $('#panelLinkParent').hide();
            $('#btnNewParent').addClass('active');
            $('#btnLinkParent').removeClass('active');
            // Re-enable required fields
            $('[name="ParentName"],[name="ParentPhone"],[name="ParentEmail"]').prop('required', true);
        } else {
            $('#panelNewParent').hide();
            $('#panelLinkParent').show();
            $('#btnNewParent').removeClass('active');
            $('#btnLinkParent').addClass('active');
            // Remove required from fields not needed when linking
            $('[name="ParentName"],[name="ParentPhone"],[name="ParentEmail"]').prop('required', false);
        }
    }

    // Debounced search
    let searchTimer;
    $('#parentSearchInput').on('input', function () {
        clearTimeout(searchTimer);
        const q = this.value.trim();
        if (q.length < 2) { $('#parentSearchResults').hide().empty(); return; }
        searchTimer = setTimeout(() => searchParents(q), 300);
    });

    async function searchParents(q) {
        const url = '@Url.Action("SearchParents","ClassRoom")?q=' + encodeURIComponent(q);
        try {
            const results = await $.getJSON(url);
            const $res = $('#parentSearchResults').empty();
            if (!results || results.length === 0) {
                $res.html('<div class="list-group-item text-muted small">No parent accounts found.</div>').show();
                return;
            }
            results.forEach(p => {
                const ini = p.name.split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase();
                $res.append(`
                  <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2"
                          onclick="selectParent('${p.profileId}','${escHtml(p.name)}','${escHtml(p.email)}','${escHtml(p.phone)}')">
                    <div class="rounded-circle bg-warning bg-opacity-20 d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-warning"
                         style="width:34px;height:34px;font-size:.8rem">${ini}</div>
                    <div>
                      <div class="fw-semibold">${escHtml(p.name)}</div>
                      <small class="text-muted">${escHtml(p.email)} ${p.phone ? '· ' + escHtml(p.phone) : ''}</small>
                    </div>
                  </button>`);
            });
            $res.show();
        } catch (e) {}
    }

    function selectParent(profileId, name, email, phone) {
        $('#linkedParentProfileId').val(profileId);
        $('#linkedParentName').val(name);
        $('#selectedParentNameDisplay').text(name);
        $('#selectedParentEmailDisplay').text(email + (phone ? ' · ' + phone : ''));
        $('#selectedParentCard').show();
        $('#noParentSelected').hide();
        $('#parentSearchResults').hide().empty();
        $('#parentSearchInput').val('');
    }

    function clearParentLink() {
        $('#linkedParentProfileId').val('');
        $('#linkedParentName').val('');
        $('#selectedParentCard').hide();
        $('#noParentSelected').show();
        $('#parentSearchInput').val('');
    }

    function escHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
</script>
}
