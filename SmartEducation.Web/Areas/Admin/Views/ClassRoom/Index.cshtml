@model IEnumerable<SmartEducation.Web.Areas.Admin.Models.ClassRoomViewModel>
@{
    ViewData["Title"] = "Classrooms";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Classrooms</h4>
            <p class="text-muted mb-0">Manage classrooms and sections.</p>
        </div>
        <a asp-area="Admin" asp-controller="ClassRoom" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add Classroom
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Classroom Name</th>
                    <th>Grade</th>
                    <th>Students</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bx bx-buildings fs-1 d-block mb-2"></i>
                            No classrooms found. <a asp-action="Create">Add the first one.</a>
                        </td>
                    </tr>
                }
                @{ int i = 1; }
                @foreach (var room in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td><span class="fw-semibold">@room.Name</span></td>
                        <td><span class="badge bg-label-primary">@room.GradeName</span></td>
                        <td>@room.StudentCount students</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@room.Id"
                               class="btn btn-sm btn-primary me-1">
                                <i class="bx bx-edit-alt me-1"></i> Edit Classroom
                            </a>
                            <form asp-action="Delete" asp-route-id="@room.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this classroom?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bx bx-trash me-1"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
