@model IEnumerable<SmartEducation.Web.Areas.Admin.Models.ClassRoomViewModel>
@{
    ViewData["Title"] = "Classes";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Classes</h4>
            <p class="text-muted mb-0">Create and manage classes. Each class contains students, subjects, and teacher assignments.</p>
        </div>
        <a asp-area="Admin" asp-controller="ClassRoom" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Create Class
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm text-center py-5">
                <div class="card-body">
                    <i class="bx bx-buildings fs-1 text-muted d-block mb-3"></i>
                    <h5 class="text-muted">No classes yet</h5>
                    <p class="text-muted mb-4">Start by creating your first class (e.g., Grade 7A)</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bx bx-plus me-1"></i> Create First Class
                    </a>
                </div>
            </div>
        </div>
    }
    @foreach (var room in Model)
    {
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">@room.Name</h5>
                            <span class="badge bg-label-primary">@room.GradeName</span>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-icon btn-sm" data-bs-toggle="dropdown">
                                <i class="bx bx-dots-vertical-rounded"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@room.Id">
                                        <i class="bx bx-edit me-2"></i>Edit Class
                                    </a>
                                </li>
                                <li>
                                    <form asp-action="Delete" asp-route-id="@room.Id" method="post"
                                          onsubmit="return confirm('Delete @room.Name? This cannot be undone.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bx bx-trash me-2"></i>Delete Class
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-4 text-center">
                            <div class="bg-primary bg-opacity-10 rounded p-2">
                                <div class="fw-bold text-primary fs-5">@room.StudentCount</div>
                                <small class="text-muted">Students</small>
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="bg-success bg-opacity-10 rounded p-2">
                                <div class="fw-bold text-success fs-5">@room.SubjectCount</div>
                                <small class="text-muted">Subjects</small>
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="bg-warning bg-opacity-10 rounded p-2">
                                <div class="fw-bold text-warning fs-5">@room.TeacherAssignmentCount</div>
                                <small class="text-muted">Teachers</small>
                            </div>
                        </div>
                    </div>

                    <a asp-action="Manage" asp-route-id="@room.Id" class="btn btn-primary w-100">
                        <i class="bx bx-cog me-1"></i> Manage Class
                    </a>
                </div>
            </div>
        </div>
    }
</div>
