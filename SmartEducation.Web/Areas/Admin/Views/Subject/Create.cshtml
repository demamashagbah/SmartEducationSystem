@{
    ViewData["Title"] = "Add Subject";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    var classRoomId   = (Guid)ViewBag.ClassRoomId;
    var classRoomName = (string)ViewBag.ClassRoomName;
}

<style>
    .upload-zone {
        border: 2px dashed #696cff; border-radius: 12px;
        padding: 2.5rem 1.5rem; text-align: center; cursor: pointer;
        transition: background .2s, border-color .2s; background: #fafaff;
    }
    .upload-zone:hover, .upload-zone.drag-over { background: #f0f0ff; border-color: #4748c4; }
    .upload-zone.has-file { background: #f0fff4; border-color: #71dd37; }
    .step-badge { width:32px;height:32px;border-radius:50%;background:#696cff;color:white;
                  font-weight:700;display:flex;align-items:center;justify-content:center;
                  flex-shrink:0;font-size:.85rem; }
</style>

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-controller="ClassRoom" asp-action="Index" class="text-muted text-decoration-none small">
                <i class="bx bx-arrow-back me-1"></i>Classes
            </a>
            <span class="text-muted">/</span>
            <a asp-controller="ClassRoom" asp-action="Manage" asp-route-id="@classRoomId"
               class="text-muted text-decoration-none small">@classRoomName</a>
            <span class="text-muted">/</span>
            <span class="small fw-semibold">Add Subject</span>
        </div>
        <h4 class="fw-bold mb-1">
            <i class="bx bx-book-open text-primary me-2"></i>Add Subject to @classRoomName
        </h4>
        <p class="text-muted mb-0">
            Upload the official Teacher Guide PDF — the system will automatically extract the complete curriculum.
        </p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div><i class="bx bx-error-circle me-1"></i>@e.ErrorMessage</div>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Create" asp-controller="Subject" method="post" enctype="multipart/form-data" id="createForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="classRoomId" value="@classRoomId" />

    <div class="row g-4">

        <!-- LEFT: Form steps -->
        <div class="col-lg-8">

            <!-- Step 1: Subject Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary bg-opacity-10 border-0 py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="step-badge">1</div>
                        <div>
                            <h6 class="fw-bold text-primary mb-0">Subject Information</h6>
                            <small class="text-muted">Name and description of the subject</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Subject Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="subjectName" class="form-control form-control-lg"
                               placeholder="e.g. Mathematics, Science, English Language..."
                               required autofocus id="subjectNameInput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description <small class="text-muted">(optional)</small></label>
                        <textarea name="description" class="form-control" rows="2"
                                  placeholder="Brief overview of the subject..."></textarea>
                    </div>
                    <div>
                        <label class="form-label fw-semibold">
                            Academic Year <small class="text-muted">(optional)</small>
                        </label>
                        <select name="academicYearId" class="form-select">
                            <option value="">— Select Academic Year —</option>
                            @foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.AcademicYears)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Step 2: Teacher Guide PDF (Required) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success bg-opacity-10 border-0 py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="step-badge" style="background:#71dd37">2</div>
                        <div>
                            <h6 class="fw-bold text-success mb-0">
                                Teacher Guide PDF
                                <span class="badge bg-danger ms-2" style="font-size:.7rem">Required</span>
                            </h6>
                            <small class="text-muted">AI will extract the complete curriculum from this guide</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="upload-zone" id="uploadZone" onclick="document.getElementById('pdfInput').click()">
                        <i class="bx bx-file-pdf text-danger" style="font-size:3rem"></i>
                        <div class="fw-semibold mt-2" id="uploadLabel">Click to select Teacher Guide PDF</div>
                        <small class="text-muted d-block mt-1">or drag and drop here</small>
                        <small class="text-muted d-block">PDF only &bull; Maximum 50 MB</small>
                    </div>
                    <input type="file" id="pdfInput" name="teacherGuidePdf"
                           accept=".pdf,application/pdf" class="d-none"
                           required onchange="onFileSelected(this)" />
                    <div id="fileInfo" class="mt-3 d-none">
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background:#f0fff4;border:1px solid #b7f5c4">
                            <i class="bx bx-file-pdf text-danger fs-3"></i>
                            <div class="flex-grow-1">
                                <div class="fw-semibold" id="fileName"></div>
                                <small class="text-muted" id="fileSize"></small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearFile()">
                                <i class="bx bx-x"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: What AI will extract -->
            <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#696cff0d,#71dd370d)">
                <div class="card-header bg-transparent border-0 py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="step-badge" style="background:#fd7e14">3</div>
                        <h6 class="fw-bold mb-0" style="color:#fd7e14">AI Extraction — Runs Automatically</h6>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div class="row g-3">
                        @foreach (var item in new[] {
                            ("bx-cube", "primary", "Units", "Major curriculum divisions"),
                            ("bx-book", "success", "Lessons", "Individual lesson sequences"),
                            ("bx-tag", "warning", "Topics", "Specific topics per lesson"),
                            ("bx-check-circle", "info", "Learning Outcomes", "Student competencies"),
                            ("bx-run", "success", "Activities", "Classroom activity suggestions"),
                            ("bx-note", "secondary", "Teacher Notes", "Strategies & assessment tips")
                        })
                        {
                            <div class="col-md-6">
                                <div class="d-flex gap-2 align-items-center p-2 rounded-3" style="background:rgba(255,255,255,.6)">
                                    <i class="bx @item.Item1 text-@item.Item2 fs-5"></i>
                                    <div>
                                        <div class="fw-semibold small">@item.Item3</div>
                                        <small class="text-muted">@item.Item4</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Status + Submit -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top:80px">
                <div class="card-header bg-transparent border-0 py-3">
                    <h6 class="fw-bold mb-0"><i class="bx bx-list-check me-2 text-primary"></i>Checklist</h6>
                </div>
                <div class="card-body pt-0">
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded-3" id="step1Status">
                            <i class="bx bx-circle text-muted fs-5" id="step1Icon"></i>
                            <small class="fw-semibold text-muted" id="step1Text">Enter subject name</small>
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded-3" id="step2Status">
                            <i class="bx bx-circle text-muted fs-5" id="step2Icon"></i>
                            <small class="fw-semibold text-muted" id="step2Text">Upload Teacher Guide PDF</small>
                        </div>
                        <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background:#f8f9fa">
                            <i class="bx bx-brain text-warning fs-5"></i>
                            <small class="fw-semibold text-muted">AI extraction — automatic</small>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
                            <i class="bx bx-brain me-2"></i>Create &amp; Extract Curriculum
                        </button>
                        <a asp-controller="ClassRoom" asp-action="Manage" asp-route-id="@classRoomId"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        <i class="bx bx-info-circle me-1"></i>
                        The Teacher Guide PDF is <strong>mandatory</strong>. The subject cannot be saved without it. After creation, teachers will immediately see the full curriculum.
                    </p>
                </div>
            </div>
        </div>

    </div>
</form>

@section Scripts {
<script>
const nameInput  = document.getElementById('subjectNameInput');
const pdfInput   = document.getElementById('pdfInput');
const submitBtn  = document.getElementById('submitBtn');
const uploadZone = document.getElementById('uploadZone');
let hasFile = false;

function updateState() {
    const ok1 = nameInput.value.trim().length >= 2;
    const ok2 = hasFile;
    submitBtn.disabled = !(ok1 && ok2);

    // Step 1
    document.getElementById('step1Icon').className = ok1
        ? 'bx bx-check-circle text-success fs-5' : 'bx bx-circle text-muted fs-5';
    document.getElementById('step1Status').style.background = ok1 ? '#f0fff4' : '#f8f9fa';
    document.getElementById('step1Text').textContent = ok1 ? `"${nameInput.value.trim()}" ✓` : 'Enter subject name';
    document.getElementById('step1Text').className = ok1 ? 'fw-semibold text-success small' : 'fw-semibold text-muted small';

    // Step 2
    document.getElementById('step2Icon').className = ok2
        ? 'bx bx-check-circle text-success fs-5' : 'bx bx-circle text-muted fs-5';
    document.getElementById('step2Status').style.background = ok2 ? '#f0fff4' : '#f8f9fa';
    document.getElementById('step2Text').textContent = ok2 ? 'PDF ready ✓' : 'Upload Teacher Guide PDF';
    document.getElementById('step2Text').className = ok2 ? 'fw-semibold text-success small' : 'fw-semibold text-muted small';
}

nameInput.addEventListener('input', updateState);

function onFileSelected(input) {
    if (!input.files || !input.files[0]) return;
    const f = input.files[0];
    if (!f.name.toLowerCase().endsWith('.pdf')) {
        alert('Only PDF files are accepted.'); clearFile(); return;
    }
    if (f.size > 52428800) { alert('File must be under 50 MB.'); clearFile(); return; }
    hasFile = true;
    uploadZone.classList.add('has-file');
    document.getElementById('uploadLabel').textContent = f.name;
    document.getElementById('fileName').textContent  = f.name;
    document.getElementById('fileSize').textContent  = (f.size / 1048576).toFixed(2) + ' MB';
    document.getElementById('fileInfo').classList.remove('d-none');
    updateState();
}

function clearFile() {
    hasFile = false;
    pdfInput.value = '';
    uploadZone.classList.remove('has-file');
    document.getElementById('uploadLabel').textContent = 'Click to select Teacher Guide PDF';
    document.getElementById('fileInfo').classList.add('d-none');
    updateState();
}

uploadZone.addEventListener('dragover',  e => { e.preventDefault(); uploadZone.classList.add('drag-over'); });
uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('drag-over'));
uploadZone.addEventListener('drop', e => {
    e.preventDefault(); uploadZone.classList.remove('drag-over');
    if (e.dataTransfer.files[0]) {
        const dt = new DataTransfer(); dt.items.add(e.dataTransfer.files[0]);
        pdfInput.files = dt.files; onFileSelected(pdfInput);
    }
});

document.getElementById('createForm').addEventListener('submit', () => {
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Extracting curriculum...';
    submitBtn.disabled  = true;
});

updateState();
</script>
}
