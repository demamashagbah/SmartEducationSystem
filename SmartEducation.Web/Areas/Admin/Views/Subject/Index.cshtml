@model IEnumerable<SmartEducation.Application.DTOs.SubjectDto>
@{
    
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Academic Subjects</h4>
            <p class="text-muted mb-0">Manage school curriculums, course details, and monitor educational courses.</p>
        </div>
        <button class="btn btn-primary"><i class="bx bx-plus me-1"></i> Add New Subject</button>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-0">
        <h5 class="mb-0">Subjects Directory</h5>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Subject Name</th>
                    <th>Description</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            No subjects discovered in the database execution schema.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var subject in Model)
                    {
                        <tr>
                            <td><span class="fw-bold text-dark">@subject.Name</span></td>
                            <td><span class="text-secondary">@subject.Description</span></td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded fs-5"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a class="dropdown-item" href="#"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                        <a class="dropdown-item text-danger" href="#"><i class="bx bx-trash me-1"></i> Delete</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>