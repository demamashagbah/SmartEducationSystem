@model IEnumerable<SmartEducation.Web.Areas.Admin.Models.SubjectViewModel>
@{
    ViewData["Title"] = "Subjects";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Academic Subjects</h4>
            <p class="text-muted mb-0">Manage school subjects and curriculums.</p>
        </div>
        <a asp-area="Admin" asp-controller="Subject" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add Subject
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Subject Name</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bx bx-book-open fs-1 d-block mb-2"></i>
                            No subjects found. <a asp-action="Create">Add the first one.</a>
                        </td>
                    </tr>
                }
                else
                {
                    int i = 1;
                    foreach (var subject in Model)
                    {
                        <tr>
                            <td>@i++</td>
                            <td><span class="fw-semibold">@subject.Name</span></td>
                            <td><span class="text-secondary">@(subject.Description ?? "—")</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@subject.Id"
                                   class="btn btn-sm btn-info text-white me-1" title="Curriculum Explorer">
                                    <i class="bx bx-book-reader me-1"></i> Curriculum
                                </a>
                                <a asp-action="Edit" asp-route-id="@subject.Id"
                                   class="btn btn-sm btn-primary me-1" title="Edit Subject">
                                    <i class="bx bx-edit-alt me-1"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@subject.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this subject?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" title="Delete Subject">
                                        <i class="bx bx-trash me-1"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>