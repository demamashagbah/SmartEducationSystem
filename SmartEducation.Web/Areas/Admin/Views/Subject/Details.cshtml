@model SmartEducation.Application.DTOs.SubjectCurriculumDto
@{
    ViewData["Title"] = $"Curriculum: {Model.SubjectName}";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<style>
    .curriculum-tree { font-size: .92rem; }
    .unit-block { border-left: 4px solid #696cff; }
    .lesson-block { border-left: 3px solid #71dd37; }
    .topic-block { border-left: 2px solid #fd7e14; }
    .outcome-item { border-left: 2px solid #20c997; }
    .stat-pill { background: #f0f0ff; border-radius: 50px; padding: .25rem .75rem; font-size: .82rem; }
</style>

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="ClassRoom" asp-action="Index" class="text-muted text-decoration-none">Classes</a>
                <span class="text-muted">/</span>
                @if (Model.ClassRoomId != Guid.Empty)
                {
                    <a asp-controller="ClassRoom" asp-action="Manage" asp-route-id="@Model.ClassRoomId"
                       class="text-muted text-decoration-none">@Model.ClassRoomName</a>
                    <span class="text-muted">/</span>
                }
                <span>Curriculum</span>
            </div>
            <h4 class="fw-bold mb-1"><i class="bx bx-book-reader text-info me-2"></i>@Model.SubjectName — Curriculum</h4>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted mb-0">@Model.Description</p>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-action="UploadGuide" asp-route-id="@Model.SubjectId" class="btn btn-primary btn-sm">
                <i class="bx bx-upload me-1"></i> Upload Teacher Guide
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bx bx-arrow-back me-1"></i> Back
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
            <h3 class="fw-bold text-primary mb-0">@Model.TotalUnits</h3>
            <small class="text-muted">Units</small>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
            <h3 class="fw-bold text-success mb-0">@Model.TotalLessons</h3>
            <small class="text-muted">Lessons</small>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
            <h3 class="fw-bold text-warning mb-0">@Model.TotalTopics</h3>
            <small class="text-muted">Topics</small>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center"><div class="card-body py-3">
            <h3 class="fw-bold text-info mb-0">@Model.TotalLearningOutcomes</h3>
            <small class="text-muted">Learning Outcomes</small>
        </div></div>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="curriculumTabs">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-curriculum">
        <i class="bx bx-sitemap me-1"></i>Curriculum Tree
    </a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-guides">
        <i class="bx bx-file-pdf me-1"></i>Teacher Guides (@Model.TeacherGuides.Count)
    </a></li>
</ul>

<div class="tab-content">
    <!-- Curriculum Tree Tab -->
    <div class="tab-pane fade show active" id="tab-curriculum">
        @if (!Model.Units.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bx bx-book-open fs-1 text-muted d-block mb-3"></i>
                    <h5 class="text-muted">No curriculum structure yet</h5>
                    <p class="text-muted">Upload the Teacher Guide PDF and use AI extraction to automatically populate the curriculum.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-action="UploadGuide" asp-route-id="@Model.SubjectId" class="btn btn-warning text-dark">
                            <i class="bx bx-upload me-1"></i>Upload Guide &amp; Extract with AI
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="curriculum-tree">
                @foreach (var unit in Model.Units)
                {
                    <div class="card border-0 shadow-sm mb-3 unit-block">
                        <div class="card-header bg-transparent border-0 d-flex align-items-center gap-2 py-2">
                            <i class="bx bx-cube text-primary fs-5"></i>
                            <span class="fw-bold text-primary">Unit: @unit.Name</span>
                            <span class="stat-pill ms-2">@unit.Lessons.Count lesson(s)</span>
                        </div>
                        <div class="card-body pt-0">
                            @foreach (var lesson in unit.Lessons)
                            {
                                <div class="lesson-block p-2 ms-3 mb-2 rounded-end">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bx bx-book text-success"></i>
                                        <span class="fw-semibold text-success">Lesson: @lesson.Name</span>
                                        <span class="stat-pill" style="background:#f0fff0">@lesson.Topics.Count topic(s)</span>
                                    </div>
                                    @foreach (var topic in lesson.Topics)
                                    {
                                        <div class="topic-block p-2 ms-3 mb-2 rounded-end" style="background:#fffdf8">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bx bx-tag text-warning"></i>
                                                <span class="fw-semibold" style="color:#856404">Topic: @topic.Name</span>
                                                <span class="stat-pill" style="background:#fff3e0">@topic.LearningOutcomes.Count outcome(s)</span>
                                            </div>
                                            @if (topic.LearningOutcomes.Any())
                                            {
                                                <div class="ms-4 mt-1">
                                                    @foreach (var lo in topic.LearningOutcomes)
                                                    {
                                                        <div class="outcome-item p-1 mb-1 rounded-end small" style="background:#f0fff9;padding-left:8px!important">
                                                            <i class="bx bx-check-circle text-success me-1"></i>@lo
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Teacher Guides Tab -->
    <div class="tab-pane fade" id="tab-guides">
        <div class="d-flex justify-content-end mb-3">
            <a asp-action="UploadGuide" asp-route-id="@Model.SubjectId" class="btn btn-primary btn-sm">
                <i class="bx bx-upload me-1"></i> Upload New Guide
            </a>
        </div>

        @if (!Model.TeacherGuides.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bx bx-file-pdf fs-1 text-muted d-block mb-3"></i>
                    <h5 class="text-muted">No Teacher Guides uploaded yet</h5>
                    <p class="text-muted">Upload the official Teacher Guide PDF for this subject.</p>
                    <a asp-action="UploadGuide" asp-route-id="@Model.SubjectId" class="btn btn-primary">
                        <i class="bx bx-upload me-1"></i> Upload Teacher Guide
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var guide in Model.TeacherGuides)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:50px;height:50px;background:#fde8e8">
                                        <i class="bx bx-file-pdf text-danger fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1">@guide.FileName</h6>
                                        @if (!string.IsNullOrEmpty(guide.Description))
                                        {
                                            <p class="small text-muted mb-1">@guide.Description</p>
                                        }
                                        <small class="text-muted">Uploaded: @guide.UploadedAt.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 d-flex gap-2 flex-wrap">
                                <a href="@guide.FilePath" target="_blank" class="btn btn-sm btn-outline-primary flex-grow-1">
                                    <i class="bx bx-show me-1"></i> View PDF
                                </a>
                                @if (!guide.IsAnalyzed)
                                {
                                    <form asp-action="ExtractCurriculum" method="post"
                                          onsubmit="return confirm('Extract curriculum structure from this guide? This will create Units, Lessons, Topics and Learning Outcomes.')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="guideId" value="@guide.Id" />
                                        <input type="hidden" name="subjectId" value="@Model.SubjectId" />
                                        <button type="submit" class="btn btn-sm btn-warning text-dark">
                                            <i class="bx bx-brain me-1"></i>Extract with AI
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="btn btn-sm btn-success disabled">
                                        <i class="bx bx-check me-1"></i>Extracted
                                    </span>
                                }
                                <form asp-action="DeleteGuide" method="post"
                                      onsubmit="return confirm('Delete this guide?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="guideId" value="@guide.Id" />
                                    <input type="hidden" name="subjectId" value="@Model.SubjectId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
