@model List<SmartEducation.Application.DTOs.ParentDetailDto>
@{
    ViewData["Title"] = "Parents";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    string search = ViewBag.Search ?? "";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4 class="fw-bold mb-1">Parents</h4>
            <p class="text-muted mb-0">Manage parent accounts and their linked children.</p>
        </div>
        <a asp-controller="UserManagement" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add New Parent
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-3 pb-2">
        <form method="get" class="d-flex gap-2">
            <div class="input-group" style="max-width:350px">
                <span class="input-group-text bg-transparent"><i class="bx bx-search text-muted"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Name, email, phone..." />
            </div>
            <button type="submit" class="btn btn-outline-warning"><i class="bx bx-search me-1"></i>Search</button>
            @if (!string.IsNullOrEmpty(search)) { <a asp-action="Index" class="btn btn-outline-secondary"><i class="bx bx-x me-1"></i>Clear</a> }
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Parent</th>
                    <th>Phone</th>
                    <th>Children</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-5 text-muted">
                        <i class="bx bx-user fs-1 d-block mb-2"></i>
                        No parents yet. <a asp-controller="UserManagement" asp-action="Create">Add the first parent.</a>
                    </td></tr>
                }
                @{ int i = 1; }
                @foreach (var p in Model)
                {
                    <tr class="@(p.IsActive ? "" : "opacity-75")">
                        <td class="text-muted small">@i++</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-warning bg-opacity-20 rounded-circle d-flex align-items-center justify-content-center fw-bold text-warning"
                                     style="width:38px;height:38px;font-size:.85rem;flex-shrink:0">
                                    @(p.FirstName.Length > 0 ? p.FirstName[0].ToString().ToUpper() : "?")@(p.LastName.Length > 0 ? p.LastName[0].ToString().ToUpper() : "")
                                </div>
                                <div>
                                    <div class="fw-semibold">@p.FullName</div>
                                    <small class="text-muted">@p.Email</small>
                                </div>
                            </div>
                        </td>
                        <td>@(p.PhoneNumber ?? "—")</td>
                        <td>
                            @if (p.Children.Any())
                            {
                                foreach (var c in p.Children.Take(3))
                                {
                                    <span class="badge bg-label-primary me-1">@c.FullName</span>
                                }
                                if (p.Children.Count > 3) { <span class="text-muted small">+@(p.Children.Count - 3) more</span> }
                            }
                            else { <span class="text-muted small">No linked children</span> }
                        </td>
                        <td>
                            @if (p.IsActive) { <span class="badge bg-label-success">Active</span> }
                            else { <span class="badge bg-label-danger">Inactive</span> }
                        </td>
                        <td class="col-actions">
                            <div class="action-btns">
                                <a asp-action="Details" asp-route-id="@p.ProfileId"
                                   class="btn-action btn-action-view"
                                   data-bs-toggle="tooltip" title="View Details">
                                    <i class="bx bx-show"></i><span>View</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@p.ProfileId"
                                   class="btn-action btn-action-edit"
                                   data-bs-toggle="tooltip" title="Edit Parent">
                                    <i class="bx bx-edit-alt"></i><span>Edit</span>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@p.ProfileId"
                                   class="btn-action btn-action-lock"
                                   data-bs-toggle="tooltip" title="Reset Password">
                                    <i class="bx bx-lock"></i><span>Reset</span>
                                </a>
                                <form asp-action="ToggleActive" method="post" class="d-inline"
                                      onsubmit="return confirm('@(p.IsActive ? "Deactivate" : "Activate") @p.FullName?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.ProfileId" />
                                    <button type="submit"
                                            class="btn-action @(p.IsActive ? "btn-action-deactivate" : "btn-action-activate")"
                                            data-bs-toggle="tooltip"
                                            title="@(p.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bx @(p.IsActive ? "bx-pause-circle" : "bx-play-circle")"></i>
                                        <span>@(p.IsActive ? "Deactivate" : "Activate")</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
