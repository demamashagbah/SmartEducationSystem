@model IEnumerable<SmartEducation.Application.DTOs.UnitDto>
@{
    ViewData["Title"] = "Units";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Units</h4>
            <p class="text-muted mb-0">Manage curriculum units by subject.</p>
        </div>
        <a asp-area="Admin" asp-controller="Unit" asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add Unit
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter -->
<div class="mb-3">
    <form method="get" class="d-flex gap-2 align-items-center">
        <select name="subjectId" class="form-select w-auto" onchange="this.form.submit()">
            <option value="">All Subjects</option>
            @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Subjects)
            {
                if (item.Selected)
                {
                    <option value="@item.Value" selected>@item.Text</option>
                }
                else
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </form>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Unit Name</th>
                    <th>Subject</th>
                    <th>Lessons</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bx bx-book fs-1 d-block mb-2"></i>
                            No units found. <a asp-action="Create">Add the first one.</a>
                        </td>
                    </tr>
                }
                @{ int i = 1; }
                @foreach (var unit in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td><span class="fw-semibold">@unit.Name</span></td>
                        <td><span class="badge bg-label-primary">@unit.SubjectName</span></td>
                        <td>@unit.LessonCount lessons</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-sm btn-primary me-1">
                                <i class="bx bx-edit-alt me-1"></i> Edit Unit
                            </a>
                            <form asp-action="Delete" asp-route-id="@unit.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this unit?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bx bx-trash me-1"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
