@model IEnumerable<SmartEducation.Application.DTOs.MessageDto>
@{
    ViewData["Title"] = "My Messages";
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="fw-bold mb-1">Messages</h4>
            <p class="text-muted mb-0">Messages from your teachers and school.</p>
        </div>
        <a asp-action="Compose" class="btn btn-primary">
            <i class="bx bx-send me-1"></i> Send Message
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card border-0 shadow-sm">
    @if (!Model.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bx bx-inbox fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No messages yet</h5>
            <p class="text-muted">Your inbox is empty. Messages from teachers will appear here.</p>
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var msg in Model)
            {
                <div class="list-group-item list-group-item-action px-4 py-3 @(!msg.IsRead ? "fw-semibold" : "")">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:40px;height:40px;background:#696cff">
                            @msg.SenderName.Substring(0,1)
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="@(!msg.IsRead ? "fw-bold text-dark" : "text-muted")">
                                    @msg.SenderName
                                    @if (!string.IsNullOrEmpty(msg.SenderRole))
                                    {
                                        <span class="badge bg-label-secondary ms-1 small">@msg.SenderRole</span>
                                    }
                                </span>
                                <small class="text-muted">@msg.SentAt.ToString("MMM dd, HH:mm")</small>
                            </div>
                            <div class="mb-1">
                                @if (!msg.IsRead) { <span class="badge bg-primary me-1" style="font-size:.65rem">NEW</span> }
                                <a asp-action="Read" asp-route-id="@msg.Id" class="text-dark text-decoration-none">@msg.Subject</a>
                            </div>
                            <small class="text-muted">@(msg.Body.Length > 80 ? msg.Body.Substring(0, 80) + "..." : msg.Body)</small>
                        </div>
                        <a asp-action="Read" asp-route-id="@msg.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bx bx-show"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
