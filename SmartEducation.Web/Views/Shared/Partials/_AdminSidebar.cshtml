<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme d-flex flex-column"
       style="height:100vh;overflow-y:auto">

    <div class="app-brand demo" style="padding:1.5rem 1.5rem 1rem">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="app-brand-link text-decoration-none d-flex align-items-center gap-2">
            <div class="bg-primary bg-opacity-15 rounded-3 p-2">
                <i class="bx bx-graduation text-primary fs-4"></i>
            </div>
            <span class="fw-bold fs-5 text-dark">SmartEdu</span>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
            <i class="bx bx-chevron-left bx-sm align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1 flex-grow-1">

        <!-- Dashboard -->
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-home-circle"></i>
                <div>Dashboard</div>
            </a>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Analytics" class="menu-link">
                <i class="menu-icon tf-icons bx bx-bar-chart-alt-2"></i>
                <div>School Analytics</div>
            </a>
        </li>

        <!-- Class Management -->
        <li class="menu-header small text-uppercase">
            <span class="menu-header-text">Class Management</span>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="ClassRoom" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-buildings"></i>
                <div>Classes</div>
            </a>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="TeacherAssignment" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-link"></i>
                <div>Teacher Assignments</div>
            </a>
        </li>

        <!-- People -->
        <li class="menu-header small text-uppercase">
            <span class="menu-header-text">People</span>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="Student" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-user-circle"></i>
                <div>Students</div>
            </a>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="Teacher" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-chalkboard"></i>
                <div>Teachers</div>
            </a>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="Parent" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-user"></i>
                <div>Parents</div>
            </a>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="UserManagement" asp-action="Create" class="menu-link">
                <i class="menu-icon tf-icons bx bx-user-plus"></i>
                <div>Create User</div>
            </a>
        </li>

        <!-- Academic Setup -->
        <li class="menu-header small text-uppercase">
            <span class="menu-header-text">Academic Setup</span>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="Grade" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-category"></i>
                <div>Grades</div>
            </a>
        </li>
        <li class="menu-item">
            <a asp-area="Admin" asp-controller="AcademicYear" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-calendar"></i>
                <div>Academic Years</div>
            </a>
        </li>

    </ul>

    <!-- Logout — pinned at bottom -->
    <div class="mt-auto px-3 pb-4 pt-2" style="border-top:1px solid rgba(0,0,0,.06)">
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn w-100 d-flex align-items-center justify-content-center gap-2 py-2 rounded-3"
                    style="background:rgba(255,62,29,.06);color:#ff3e1d;border:1px solid rgba(255,62,29,.15);transition:.2s"
                    onmouseover="this.style.background='rgba(255,62,29,.15)'"
                    onmouseout="this.style.background='rgba(255,62,29,.06)'">
                <i class="bx bx-power-off"></i>
                <span class="fw-semibold">Logout</span>
            </button>
        </form>
    </div>

</aside>
