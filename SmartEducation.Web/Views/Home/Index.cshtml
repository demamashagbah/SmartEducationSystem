@{
    ViewData["Title"] = "Smart Education System - AI-Powered Learning Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root { --brand: #696cff; --brand-dark: #5f61e6; }

    /* Hero */
    .hero-section {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
        min-height: 92vh;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
    }
    .hero-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23696cff' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .hero-badge { background: rgba(105,108,255,.2); border: 1px solid rgba(105,108,255,.4); color: #a8aaff; }
    .hero-title { font-size: clamp(2rem, 5vw, 3.8rem); font-weight: 800; line-height: 1.1; color: #fff; }
    .hero-title span { background: linear-gradient(135deg, #696cff, #9b59b6, #e74c3c); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-subtitle { color: rgba(255,255,255,.75); font-size: 1.15rem; line-height: 1.7; }
    .btn-hero-primary { background: linear-gradient(135deg, var(--brand), var(--brand-dark)); border: none; color: #fff; padding: .8rem 2.2rem; font-weight: 600; border-radius: 50px; font-size: 1rem; transition: all .25s; box-shadow: 0 8px 24px rgba(105,108,255,.4); }
    .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(105,108,255,.6); color: #fff; }
    .btn-hero-outline { background: transparent; border: 2px solid rgba(255,255,255,.3); color: #fff; padding: .8rem 2.2rem; font-weight: 600; border-radius: 50px; font-size: 1rem; transition: all .25s; }
    .btn-hero-outline:hover { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.6); color: #fff; transform: translateY(-2px); }

    /* Hero illustration */
    .hero-illustration { position: relative; }
    .hero-illustration .main-card {
        background: rgba(255,255,255,.07);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 24px;
        padding: 2rem;
    }
    .float-card {
        background: rgba(255,255,255,.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 16px;
        padding: .8rem 1.2rem;
        position: absolute;
    }

    /* Sections */
    .section-badge { background: rgba(105,108,255,.1); color: var(--brand); border-radius: 50px; padding: .3rem 1rem; font-size: .85rem; font-weight: 600; display: inline-block; margin-bottom: 1rem; }
    .section-title { font-size: 2.2rem; font-weight: 800; color: #2b2d42; }
    .section-subtitle { color: #6c757d; font-size: 1.05rem; max-width: 600px; margin: 0 auto; }

    /* Feature Cards */
    .feature-card { border: none; border-radius: 20px; padding: 2rem; transition: all .3s; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,.06); }
    .feature-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,.12); }
    .feature-icon { width: 72px; height: 72px; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; font-size: 1.8rem; }

    /* Role Cards */
    .role-card { border-radius: 24px; padding: 2.5rem 2rem; color: #fff; position: relative; overflow: hidden; min-height: 340px; }
    .role-card::before { content: ''; position: absolute; top: -50%; right: -30%; width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,.08); }
    .role-card::after { content: ''; position: absolute; bottom: -40%; left: -20%; width: 160px; height: 160px; border-radius: 50%; background: rgba(255,255,255,.06); }
    .role-admin { background: linear-gradient(135deg, #696cff, #5f61e6); }
    .role-teacher { background: linear-gradient(135deg, #71dd37, #28a745); }
    .role-student { background: linear-gradient(135deg, #fd7e14, #e67e22); }
    .role-parent { background: linear-gradient(135deg, #e74c3c, #c0392b); }

    /* Stats */
    .stat-card { border-radius: 20px; padding: 2rem; text-align: center; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,.06); }
    .stat-number { font-size: 2.8rem; font-weight: 900; background: linear-gradient(135deg, var(--brand), #9b59b6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

    /* AI Section */
    .ai-section { background: linear-gradient(135deg, #f8f9ff 0%, #fff 100%); }
    .ai-feature-item { display: flex; align-items: flex-start; gap: 1.2rem; padding: 1.2rem; border-radius: 16px; transition: background .2s; }
    .ai-feature-item:hover { background: rgba(105,108,255,.06); }
    .ai-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

    /* Testimonials */
    .testimonial-card { border: none; border-radius: 20px; padding: 2rem; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,.06); }
    .testimonial-avatar { width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.2rem; color: #fff; }

    /* Footer */
    .site-footer { background: #1a1a2e; color: rgba(255,255,255,.7); }
    .site-footer h5 { color: #fff; }
    .site-footer a { color: rgba(255,255,255,.6); text-decoration: none; transition: color .2s; }
    .site-footer a:hover { color: #fff; }
    .footer-brand { background: linear-gradient(135deg, var(--brand), #9b59b6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
</style>

<!-- ======================== HERO ======================== -->
<section class="hero-section">
    <div class="container position-relative py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="hero-badge px-3 py-1 rounded-pill mb-4 d-inline-block">
                    <i class="bx bx-brain me-2"></i>AI-Powered Educational Platform
                </span>
                <h1 class="hero-title mb-4">
                    Smart Adaptive<br>
                    <span>Educational Ecosystem</span>
                </h1>
                <p class="hero-subtitle mb-5">
                    Transforming Schools Through Artificial Intelligence, Adaptive Learning,
                    and Educational Analytics — connecting every stakeholder in one unified platform.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-hero-primary">
                        <i class="bx bx-rocket me-2"></i>Get Started
                    </a>
                    <a href="#features" class="btn btn-hero-outline">
                        <i class="bx bx-play-circle me-2"></i>Explore Features
                    </a>
                </div>
                <!-- Trust Indicators -->
                <div class="d-flex flex-wrap gap-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bx bx-check-circle text-success fs-5"></i>
                        <small class="text-white-50">AI-Powered Analytics</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bx bx-check-circle text-success fs-5"></i>
                        <small class="text-white-50">Role-Based Access</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bx bx-check-circle text-success fs-5"></i>
                        <small class="text-white-50">Real-Time Insights</small>
                    </div>
                </div>
            </div>

            <!-- Dashboard Illustration -->
            <div class="col-lg-6 hero-illustration">
                <div class="main-card">
                    <!-- Mini Dashboard Preview -->
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <div class="text-white fw-bold mb-1">School Dashboard</div>
                            <small style="color:rgba(255,255,255,.5)">Academic Year 2025-2026</small>
                        </div>
                        <span style="background:rgba(113,221,55,.2);color:#71dd37;padding:.3rem .8rem;border-radius:50px;font-size:.8rem;font-weight:600;">
                            ● Live
                        </span>
                    </div>

                    <!-- Stats Row -->
                    <div class="row g-2 mb-4">
                        @foreach (var stat in new[] {
                            new { label = "Students", value = "1,250", icon = "bx-user-circle", color = "#696cff" },
                            new { label = "Teachers", value = "85", icon = "bx-chalkboard", color = "#71dd37" },
                            new { label = "Subjects", value = "12", icon = "bx-book-open", color = "#fd7e14" },
                            new { label = "Success", value = "87%", icon = "bx-trending-up", color = "#e74c3c" }
                        })
                        {
                            <div class="col-6">
                                <div style="background:rgba(255,255,255,.07);border-radius:14px;padding:.9rem 1rem;">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bx @stat.icon" style="color:@stat.color;font-size:1.1rem;"></i>
                                        <small style="color:rgba(255,255,255,.5);font-size:.75rem;">@stat.label</small>
                                    </div>
                                    <div class="fw-bold text-white fs-5">@stat.value</div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Progress Bars -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <small style="color:rgba(255,255,255,.6)">Curriculum Coverage</small>
                            <small style="color:#71dd37;font-weight:600;">82%</small>
                        </div>
                        <div style="height:6px;background:rgba(255,255,255,.1);border-radius:3px;">
                            <div style="height:100%;width:82%;background:linear-gradient(90deg,#696cff,#71dd37);border-radius:3px;"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-1">
                            <small style="color:rgba(255,255,255,.6)">Attendance Rate</small>
                            <small style="color:#696cff;font-weight:600;">92%</small>
                        </div>
                        <div style="height:6px;background:rgba(255,255,255,.1);border-radius:3px;">
                            <div style="height:100%;width:92%;background:linear-gradient(90deg,#696cff,#9b59b6);border-radius:3px;"></div>
                        </div>
                    </div>
                </div>

                <!-- Floating Cards -->
                <div class="float-card d-none d-xl-block" style="top:-20px;right:-30px;animation:float 3s ease-in-out infinite;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bx bx-brain text-primary fs-4"></i>
                        <div>
                            <small class="fw-bold d-block text-white">AI Insight</small>
                            <small style="color:rgba(255,255,255,.6);font-size:.75rem;">3 at-risk students detected</small>
                        </div>
                    </div>
                </div>
                <div class="float-card d-none d-xl-block" style="bottom:-15px;left:-25px;animation:float 3.5s ease-in-out infinite .5s;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bx bx-check-circle text-success fs-4"></i>
                        <div>
                            <small class="fw-bold d-block text-white">Lesson Plan</small>
                            <small style="color:rgba(255,255,255,.6);font-size:.75rem;">AI generated successfully</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
@@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}
</style>

<!-- ======================== STATS ======================== -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4">
            @foreach (var stat in new[] {
                new { number = "10,000+", label = "Students Enrolled", icon = "bx-user-circle", color = "#696cff" },
                new { number = "500+", label = "Teachers Using Platform", icon = "bx-chalkboard", color = "#71dd37" },
                new { number = "95%", label = "Parent Satisfaction", icon = "bx-heart", color = "#e74c3c" },
                new { number = "87%", label = "Average Success Rate", icon = "bx-trending-up", color = "#fd7e14" }
            })
            {
                <div class="col-md-3 col-6">
                    <div class="stat-card">
                        <div class="rounded-3 mb-3 mx-auto d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:@(stat.color)22;">
                            <i class="bx @stat.icon fs-3" style="color:@stat.color;"></i>
                        </div>
                        <div class="stat-number">@stat.number</div>
                        <p class="text-muted mb-0 small fw-semibold">@stat.label</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ======================== ALTERNATING FEATURE SECTIONS ======================== -->
<style>
    .feat-section { padding: 5rem 0; }
    .feat-section:nth-child(even) { background: #f8f9ff; }
    .feat-illus { border-radius: 24px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,.12); }
    .feat-badge { background: rgba(105,108,255,.1); color: #696cff; border-radius: 50px; padding: .25rem .9rem; font-size: .8rem; font-weight: 700; display: inline-block; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: .05em; }
    .feat-title { font-size: 2rem; font-weight: 800; color: #2b2d42; line-height: 1.25; }
    .feat-desc { color: #6c757d; font-size: 1rem; line-height: 1.75; margin: 1.2rem 0 1.8rem; }
    .feat-points li { margin-bottom: .6rem; font-size: .93rem; color: #495057; display: flex; align-items: flex-start; gap: .6rem; }
    .feat-points li i { color: #696cff; margin-top: .15rem; flex-shrink: 0; }
    .btn-feat { background: linear-gradient(135deg, #696cff, #5f61e6); color: #fff; border: none; border-radius: 10px; padding: .65rem 1.6rem; font-weight: 600; font-size: .92rem; transition: all .2s; display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; }
    .btn-feat:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(105,108,255,.4); color: #fff; }
</style>

<!-- Feature 1: AI Curriculum Analysis — Image Left -->
<section class="feat-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 order-lg-1">
                <div class="feat-illus" style="background:linear-gradient(135deg,#1a1a2e,#0f3460);padding:3rem 2rem;">
                    <!-- Curriculum analysis illustration -->
                    <div class="text-white">
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <div style="width:10px;height:10px;border-radius:50%;background:#e74c3c"></div>
                            <div style="width:10px;height:10px;border-radius:50%;background:#fd7e14"></div>
                            <div style="width:10px;height:10px;border-radius:50%;background:#71dd37"></div>
                            <span style="color:rgba(255,255,255,.5);font-size:.8rem;margin-left:.5rem">AI Curriculum Analyzer</span>
                        </div>
                        <!-- Upload zone visual -->
                        <div style="border:2px dashed rgba(105,108,255,.5);border-radius:16px;padding:1.5rem;text-align:center;margin-bottom:1.5rem;background:rgba(105,108,255,.08)">
                            <i class="bx bx-file-pdf text-danger" style="font-size:3rem"></i>
                            <div class="fw-semibold mt-2">Teacher Guide PDF</div>
                            <small style="color:rgba(255,255,255,.5)">Grade 8 — Mathematics</small>
                        </div>
                        <!-- Extraction results -->
                        <div style="background:rgba(113,221,55,.1);border:1px solid rgba(113,221,55,.3);border-radius:12px;padding:1rem;margin-bottom:.8rem">
                            <div class="d-flex align-items-center gap-2 mb-2"><i class="bx bx-brain" style="color:#a78bfa;font-size:1.1rem"></i><span class="fw-semibold small">AI Extraction Complete</span><span style="margin-left:auto;background:rgba(113,221,55,.2);color:#71dd37;padding:.15rem .6rem;border-radius:50px;font-size:.75rem">Done</span></div>
                            @foreach (var item in new[] { ("3 Units Extracted", "#696cff"), ("12 Lessons Created", "#71dd37"), ("28 Topics Generated", "#fd7e14"), ("84 Learning Outcomes", "#20c997") })
                            {
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <i class="bx bx-check-circle" style="color:@item.Item2;font-size:.9rem"></i>
                                    <small style="color:rgba(255,255,255,.8)">@item.Item1</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 order-lg-2">
                <span class="feat-badge">AI Curriculum Analysis</span>
                <h2 class="feat-title">From PDF to Full Curriculum in Seconds</h2>
                <p class="feat-desc">Upload the official Teacher Guide PDF and our AI automatically extracts a complete curriculum hierarchy — Units, Lessons, Topics, Learning Outcomes, Activities, and Teacher Notes.</p>
                <ul class="feat-points list-unstyled">
                    <li><i class="bx bx-check-circle"></i>Automatic extraction of units, lessons, and topics</li>
                    <li><i class="bx bx-check-circle"></i>Learning outcomes aligned to each topic</li>
                    <li><i class="bx bx-check-circle"></i>Teaching strategies and activities generated</li>
                    <li><i class="bx bx-check-circle"></i>Zero manual data entry required</li>
                </ul>
                <a asp-controller="Account" asp-action="Login" class="btn-feat">
                    <i class="bx bx-brain"></i>Try AI Extraction
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Feature 2: AI Lesson Planning — Content Left, Image Right -->
<section class="feat-section" style="background:#f8f9ff">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="feat-badge" style="background:rgba(113,221,55,.1);color:#28a745">AI Lesson Planning</span>
                <h2 class="feat-title">Intelligent Lesson Plans That Actually Teach</h2>
                <p class="feat-desc">Teachers select a subject and class — the AI generates a comprehensive curriculum plan with weekly scheduling, teaching strategies, and homework recommendations for the entire term.</p>
                <ul class="feat-points list-unstyled">
                    <li><i class="bx bx-check-circle" style="color:#71dd37"></i>Weekly, monthly, and semester plan generation</li>
                    <li><i class="bx bx-check-circle" style="color:#71dd37"></i>Lesson dates and sequences auto-scheduled</li>
                    <li><i class="bx bx-check-circle" style="color:#71dd37"></i>Activities and homework for every lesson</li>
                    <li><i class="bx bx-check-circle" style="color:#71dd37"></i>Real-time curriculum coverage tracking</li>
                </ul>
                <a asp-controller="Account" asp-action="Login" class="btn-feat" style="background:linear-gradient(135deg,#71dd37,#28a745)">
                    <i class="bx bx-calendar-edit"></i>Generate a Plan
                </a>
            </div>
            <div class="col-lg-6">
                <div class="feat-illus" style="background:linear-gradient(135deg,#0d2137,#1a4a5a);padding:2.5rem 2rem;">
                    <div class="fw-semibold text-white mb-3 d-flex align-items-center gap-2">
                        <i class="bx bx-calendar-alt text-success"></i> Curriculum Plan — Mathematics G8
                    </div>
                    @foreach (var week in new[] {
                        new { w = "Week 1", lesson = "Number Systems — Properties of Integers", done = true },
                        new { w = "Week 2", lesson = "Fractions and Equivalent Representations", done = true },
                        new { w = "Week 3", lesson = "Ratio and Proportion Applications", done = false },
                        new { w = "Week 4", lesson = "Introduction to Algebraic Expressions", done = false },
                    })
                    {
                        <div class="d-flex align-items-start gap-3 mb-3 p-2 rounded-3" style="background:rgba(255,255,255,@(week.done ? ".1" : ".05"))">
                            @if (week.done)
                            {
                                <div style="width:22px;height:22px;border-radius:50%;background:rgba(113,221,55,.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px">
                                    <i class="bx bx-check" style="color:#71dd37;font-size:.85rem"></i>
                                </div>
                            }
                            else
                            {
                                <div style="width:22px;height:22px;border-radius:50%;border:2px solid rgba(255,255,255,.2);flex-shrink:0;margin-top:2px"></div>
                            }
                            <div>
                                <div class="fw-semibold small" style="color:rgba(255,255,255,.9)">@week.w</div>
                                <small style="color:rgba(255,255,255,.5)">@week.lesson</small>
                            </div>
                        </div>
                    }
                    <div style="background:rgba(105,108,255,.15);border:1px solid rgba(105,108,255,.3);border-radius:10px;padding:.8rem;margin-top:.5rem">
                        <div class="d-flex justify-content-between mb-1">
                            <small style="color:rgba(255,255,255,.7)">Term Progress</small>
                            <small style="color:#696cff;font-weight:700">50%</small>
                        </div>
                        <div style="height:6px;background:rgba(255,255,255,.1);border-radius:3px">
                            <div style="height:100%;width:50%;background:linear-gradient(90deg,#696cff,#71dd37);border-radius:3px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Feature 3: Smart Assessments — Image Left -->
<section class="feat-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 order-lg-1">
                <div class="feat-illus" style="background:linear-gradient(135deg,#2d1a3d,#1a0d2e);padding:2.5rem 2rem;">
                    <div class="fw-semibold text-white mb-3"><i class="bx bx-file-blank text-warning me-2"></i>Exam Builder</div>
                    @foreach (var sec in new[] {
                        new { name = "Section A", type = "Multiple Choice", q = "10", mk = "1", total = "10", color = "#696cff" },
                        new { name = "Section B", type = "True / False", q = "5", mk = "2", total = "10", color = "#71dd37" },
                        new { name = "Section C", type = "Essay", q = "2", mk = "5", total = "10", color = "#fd7e14" }
                    })
                    {
                        <div class="d-flex align-items-center justify-content-between p-2 rounded-3 mb-2" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1)">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width:8px;height:8px;border-radius:50%;background:@sec.color;flex-shrink:0"></div>
                                <div>
                                    <div class="fw-semibold small text-white">@sec.name</div>
                                    <small style="color:rgba(255,255,255,.45)">@sec.q × @sec.type @@ @sec.mk mark</small>
                                </div>
                            </div>
                            <span style="background:rgba(255,255,255,.1);color:@sec.color;padding:.2rem .6rem;border-radius:6px;font-size:.8rem;font-weight:700">@sec.total</span>
                        </div>
                    }
