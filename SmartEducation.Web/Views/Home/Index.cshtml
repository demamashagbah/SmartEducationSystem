                            <li class="mb-2"><i class="bx bx-check me-2"></i>Child performance</li>
                            <li class="mb-2"><i class="bx bx-check me-2"></i>Attendance updates</li>
                            <li class="mb-2"><i class="bx bx-check me-2"></i>Exam results</li>
                            <li class="mb-2"><i class="bx bx-check me-2"></i>Teacher communication</li>
                        </ul>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-sm fw-semibold">
                            Parent Login →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ======================== TESTIMONIALS ======================== -->
<section style="padding:5rem 0;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge">Testimonials</span>
            <h2 class="section-title">Trusted by Educators</h2>
        </div>
        <div class="row g-4">
            @foreach (var t in new[] {
                new { name = "Dr. Sarah Al-Mansouri", role = "School Principal", avatar = "S", color = "#696cff", text = "Smart Education has transformed how we manage our school. The analytics dashboard gives me a complete picture of every classroom's performance in real-time. The AI-powered risk detection has helped us intervene early with struggling students." },
                new { name = "Mr. Ahmed Hassan", role = "Senior Mathematics Teacher", avatar = "A", color = "#71dd37", text = "The AI lesson plan generator saves me hours every week. I just select the topic and learning outcomes, and it generates a complete plan with activities and assessment methods. The exam generator is equally impressive." },
                new { name = "Mrs. Fatima Al-Zahra", role = "Parent", avatar = "F", color = "#e74c3c", text = "As a parent, I love being able to see my daughter's attendance and grades in real-time through the parent portal. I get notified immediately if there are any concerns, and I can communicate directly with her teachers." }
            })
            {
                <div class="col-md-4">
                    <div class="testimonial-card h-100">
                        <div class="mb-3" style="color:#fd7e14;">
                            @for (int s = 0; s < 5; s++) { <i class="bx bxs-star"></i> }
                        </div>
                        <p class="text-muted mb-4 lh-lg">@t.text</p>
                        <div class="d-flex align-items-center gap-3">
                            <div class="testimonial-avatar" style="background:@t.color;">@t.avatar</div>
                            <div>
                                <div class="fw-bold">@t.name</div>
                                <small class="text-muted">@t.role</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

