@model LoginViewModel
@{
    Layout = null;
    var hasErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Any();
    var firstError = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .FirstOrDefault() ?? "Invalid credentials. Please try again.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — SmartEdu Nexus</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.css">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --indigo:        #4f46e5;
            --indigo-dark:   #3730a3;
            --indigo-light:  #818cf8;
            --cyan:          #06b6d4;
            --cyan-light:    #67e8f9;
            --violet:        #8b5cf6;
            --green:         #10b981;
            --amber:         #f59e0b;
            --danger:        #ef4444;
            --dark-900:      #0f172a;
            --dark-800:      #1e1b4b;
            --dark-700:      #2d2280;
            --white:         #ffffff;
            --slate-50:      #f8faff;
            --slate-100:     #f1f5f9;
            --slate-200:     #e2e8f0;
            --slate-400:     #94a3b8;
            --slate-600:     #475569;
            --slate-800:     #1e293b;
        }

        html, body {
            height: 100%;
            font-family: 'Poppins', sans-serif;
            overflow: hidden;
        }

        /* ════════════════════════════════
           PAGE LAYOUT
        ════════════════════════════════ */
        .page-wrap {
            display: flex;
            height: 100vh;
            min-height: 560px;
        }

        /* ════════════════════════════════
           LEFT — FORM PANEL  (40%)
        ════════════════════════════════ */
        .form-panel {
            width: 40%;
            min-width: 360px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2.5rem 3.5rem;
            background: var(--white);
            position: relative;
            overflow-y: auto;
            z-index: 2;
            box-shadow: 8px 0 48px rgba(15,23,42,.08);
        }

        /* top accent bar */
        .form-panel::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--indigo), var(--violet), var(--cyan));
        }

        .form-inner { width: 100%; max-width: 360px; }

        /* — Logo — */
        .logo-wrap {
            display: flex;
            align-items: center;
            gap: .8rem;
            margin-bottom: 2.25rem;
        }
        .logo-hex {
            width: 46px; height: 46px;
            background: linear-gradient(135deg, var(--indigo), var(--cyan));
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 6px 20px rgba(79,70,229,.35);
        }
        .logo-hex i { font-size: 1.5rem; color: #fff; }
        .logo-copy { line-height: 1.15; }
        .logo-copy .brand-name {
            font-size: 1rem;
            font-weight: 700;
            color: var(--slate-800);
            letter-spacing: -.02em;
        }
        .logo-copy .brand-tag {
            font-size: .68rem;
            color: var(--indigo);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .07em;
        }

        /* — Heading — */
        .form-title {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--slate-800);
            line-height: 1.15;
            margin-bottom: .35rem;
        }
        .form-subtitle {
            font-size: .85rem;
            color: var(--slate-400);
            line-height: 1.65;
            margin-bottom: 2rem;
        }

        /* — Field — */
        .field { margin-bottom: 1.2rem; }
        .field-label {
            display: block;
            font-size: .78rem;
            font-weight: 600;
            color: var(--slate-600);
            margin-bottom: .38rem;
            letter-spacing: .03em;
        }
        .input-shell {
            position: relative;
            display: flex;
            align-items: center;
            background: var(--slate-50);
            border: 1.5px solid var(--slate-200);
            border-radius: 11px;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        .input-shell:focus-within {
            border-color: var(--indigo);
            box-shadow: 0 0 0 3px rgba(79,70,229,.1);
            background: var(--white);
        }
        .input-shell .fi {
            padding: 0 .85rem;
            color: var(--slate-200);
            font-size: 1.05rem;
            flex-shrink: 0;
            transition: color .2s;
            pointer-events: none;
        }
        .input-shell:focus-within .fi { color: var(--indigo); }
        .input-shell input {
            flex: 1;
            border: none;
            background: transparent;
            padding: .78rem .4rem .78rem 0;
            font-size: .875rem;
            font-family: 'Poppins', sans-serif;
            color: var(--slate-800);
            outline: none;
        }
        .input-shell input::placeholder { color: var(--slate-200); }
        .eye-btn {
            padding: 0 .85rem;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--slate-200);
            font-size: 1.05rem;
            transition: color .2s;
            display: flex;
            align-items: center;
        }
        .eye-btn:hover { color: var(--indigo); }

        /* — Options row — */
        .options-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.6rem;
        }
        .check-label {
            display: flex;
            align-items: center;
            gap: .45rem;
            cursor: pointer;
        }
        .check-label input[type="checkbox"] {
            width: 15px; height: 15px;
            accent-color: var(--indigo);
            cursor: pointer;
        }
        .check-label span {
            font-size: .8rem;
            color: var(--slate-600);
            font-weight: 500;
        }
        .forgot-link {
            font-size: .8rem;
            color: var(--indigo);
            text-decoration: none;
            font-weight: 600;
            transition: opacity .2s;
        }
        .forgot-link:hover { opacity: .7; }

        /* — Sign In button — */
        .btn-submit {
            width: 100%;
            padding: .88rem 1.5rem;
            background: linear-gradient(135deg, var(--indigo) 0%, var(--indigo-dark) 100%);
            border: none;
            border-radius: 11px;
            color: var(--white);
            font-family: 'Poppins', sans-serif;
            font-size: .9rem;
            font-weight: 700;
            letter-spacing: .03em;
            cursor: pointer;
            transition: transform .2s, box-shadow .2s;
            box-shadow: 0 8px 24px rgba(79,70,229,.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .55rem;
            margin-bottom: 1.75rem;
        }
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px rgba(79,70,229,.55);
        }
        .btn-submit:active { transform: translateY(0); }

        /* loading state */
        .spinner-ring {
            width: 18px; height: 18px;
            border: 2.5px solid rgba(255,255,255,.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .65s linear infinite;
            display: none;
        }
        .btn-submit.loading .btn-label { display: none; }
        .btn-submit.loading .spinner-ring { display: block; }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* — Back home — */
        .back-home {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            font-size: .8rem;
            color: var(--slate-400);
            text-decoration: none;
            font-weight: 500;
            transition: color .2s;
        }
        .back-home:hover { color: var(--indigo); }

        /* ════════════════════════════════
           RIGHT — ILLUSTRATION PANEL (60%)
        ════════════════════════════════ */
        .illus-panel {
            flex: 1;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 2rem;
            background: linear-gradient(140deg, var(--dark-900) 0%, var(--dark-800) 55%, var(--dark-700) 100%);
        }

        /* ambient glow */
        .illus-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 700px 550px at 85% 15%, rgba(79,70,229,.18) 0%, transparent 65%),
                radial-gradient(ellipse 450px 400px at 15% 85%, rgba(6,182,212,.12) 0%, transparent 60%),
                radial-gradient(ellipse 350px 300px at 55% 75%, rgba(139,92,246,.1) 0%, transparent 55%);
            pointer-events: none;
        }

        /* dot grid */
        .dot-grid {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.055) 1px, transparent 1px);
            background-size: 26px 26px;
            pointer-events: none;
        }

        /* decorative blobs */
        .blob {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }
        .blob-a {
            width: 420px; height: 420px;
            top: -120px; right: -100px;
            background: radial-gradient(circle, rgba(79,70,229,.14) 0%, transparent 70%);
            animation: blobDrift 9s ease-in-out infinite;
        }
        .blob-b {
            width: 300px; height: 300px;
            bottom: -90px; left: -70px;
            background: radial-gradient(circle, rgba(6,182,212,.11) 0%, transparent 70%);
            animation: blobDrift 11s ease-in-out infinite reverse;
        }
        .blob-c {
            width: 200px; height: 200px;
            top: 38%; left: 4%;
            background: radial-gradient(circle, rgba(139,92,246,.09) 0%, transparent 70%);
            animation: blobDrift 8s ease-in-out infinite 2s;
        }
        @@keyframes blobDrift {
            0%,100% { transform: translate(0,0) scale(1); }
            33%      { transform: translate(18px,-14px) scale(1.04); }
            66%      { transform: translate(-12px,18px) scale(.96); }
        }

        /* content */
        .illus-content {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 580px;
            text-align: center;
        }

        .illus-title {
            font-size: 1.95rem;
            font-weight: 800;
            color: var(--white);
            line-height: 1.2;
            margin-bottom: .5rem;
        }
        .illus-title .glow-text {
            background: linear-gradient(135deg, var(--indigo-light), var(--cyan-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .illus-sub {
            font-size: .875rem;
            color: rgba(255,255,255,.5);
            line-height: 1.75;
            max-width: 440px;
            margin: 0 auto 1.75rem;
        }

        /* ── Scene container ── */
        .scene-wrap {
            position: relative;
            width: 100%;
            max-width: 540px;
            height: 290px;
            margin: 0 auto 1.75rem;
        }
        .scene-svg { width: 100%; height: 100%; }

        /* ── Floating info badges ── */
        .info-badge {
            position: absolute;
            display: flex;
            align-items: center;
            gap: .55rem;
            background: rgba(255,255,255,.08);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 14px;
            padding: .55rem .85rem;
        }
        .ib-ai    { top: -8px;   right: 0;    animation: ibFloat 4.2s ease-in-out infinite; }
        .ib-score { bottom: 8px; left: -4px;  animation: ibFloat 4.8s ease-in-out infinite .9s; }
        .ib-up    { top: 85px;   left: -16px; animation: ibFloat 4s ease-in-out infinite 1.7s; }
        @@keyframes ibFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-7px)} }

        .ib-icon {
            width: 30px; height: 30px;
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: .95rem;
            flex-shrink: 0;
        }
        .ib-text strong { display: block; font-size: .75rem; color: #fff; font-weight: 700; }
        .ib-text span   { font-size: .68rem; color: rgba(255,255,255,.5); }

        /* ── Feature chips ── */
        .chips-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .7rem;
            flex-wrap: wrap;
        }
        .chip {
            display: flex;
            align-items: center;
            gap: .38rem;
            padding: .32rem .85rem;
            background: rgba(255,255,255,.065);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 50px;
            font-size: .75rem;
            color: rgba(255,255,255,.72);
            font-weight: 500;
            transition: background .2s, border-color .2s;
        }
        .chip:hover { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.18); }
        .chip i { font-size: .9rem; }

        /* ════════════════════════════════
           RESPONSIVE
        ════════════════════════════════ */
        @@media (max-width: 1100px) {
            .form-panel { width: 42%; padding: 2rem 2.5rem; }
        }
        @@media (max-width: 800px) {
            html, body { overflow: auto; }
            .page-wrap { flex-direction: column; height: auto; min-height: 100dvh; }
            .illus-panel { order: -1; width: 100%; padding: 2rem 1.25rem; min-height: 300px; }
            .form-panel { width: 100%; min-width: unset; box-shadow: none; padding: 2rem 1.5rem; }
            .illus-title { font-size: 1.5rem; }
            .scene-wrap { height: 210px; }
        }
        @@media (max-width: 440px) {
            .form-panel { padding: 1.5rem 1.1rem; }
            .form-title { font-size: 1.5rem; }
        }
    </style>
</head>
<body>

<div class="page-wrap">

    <!-- ══════════════════════════════════════
         LEFT — FORM PANEL
    ══════════════════════════════════════ -->
    <div class="form-panel">
        <div class="form-inner">

            <!-- Logo -->
            <div class="logo-wrap">
                <div class="logo-hex">
                    <i class='bx bxs-graduation'></i>
                </div>
                <div class="logo-copy">
                    <div class="brand-name">SmartEdu Nexus</div>
                    <div class="brand-tag">Intelligent Learning Platform</div>
                </div>
            </div>

            <!-- Heading -->
            <h1 class="form-title">Welcome Back</h1>
            <p class="form-subtitle">Sign in to access your Smart Educational Ecosystem</p>

            <!-- Form -->
            <form asp-action="Login" method="post" id="loginForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="field">
                    <label class="field-label" for="Email">Email Address</label>
                    <div class="input-shell">
                        <i class='bx bx-envelope fi'></i>
                        <input asp-for="Email" type="email" id="Email"
                               placeholder="your@email.com"
                               autocomplete="email" />
                    </div>
                </div>

                <!-- Password -->
                <div class="field">
                    <label class="field-label" for="Password">Password</label>
                    <div class="input-shell">
                        <i class='bx bx-lock-alt fi'></i>
                        <input asp-for="Password" type="password" id="Password"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                        <button type="button" class="eye-btn" onclick="togglePwd()" aria-label="Toggle password">
                            <i class='bx bx-show' id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Options -->
                <div class="options-row">
                    <label class="check-label">
                        <input type="checkbox" name="rememberMe" />
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-submit" id="submitBtn">
                    <span class="btn-label">
                        <i class='bx bx-log-in-circle'></i>
                        Sign In
                    </span>
                    <div class="spinner-ring"></div>
                </button>

            </form>

            <a asp-controller="Home" asp-action="Index" class="back-home">
                <i class='bx bx-arrow-back'></i> Back to Home
            </a>

        </div>
    </div>

    <!-- ══════════════════════════════════════
         RIGHT — ILLUSTRATION PANEL
    ══════════════════════════════════════ -->
    <div class="illus-panel">
        <div class="dot-grid"></div>
        <div class="blob blob-a"></div>
        <div class="blob blob-b"></div>
        <div class="blob blob-c"></div>

        <div class="illus-content">

            <h2 class="illus-title">
                AI-Powered<br>
                <span class="glow-text">Educational Ecosystem</span>
            </h2>
            <p class="illus-sub">
                Empowering educators with smart tools, inspiring students through personalized learning,
                and uniting every stakeholder in one intelligent platform.
            </p>

            <!-- ── Illustration scene ── -->
            <div class="scene-wrap">

                <svg class="scene-svg" viewBox="0 0 540 285" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="gCard" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%"   stop-color="rgba(255,255,255,.11)"/>
                            <stop offset="100%" stop-color="rgba(255,255,255,.04)"/>
                        </linearGradient>
                        <linearGradient id="gIndigo" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#6366f1"/>
                            <stop offset="100%" stop-color="#4f46e5"/>
                        </linearGradient>
                        <linearGradient id="gCyan" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#06b6d4"/>
                            <stop offset="100%" stop-color="#0284c7"/>
                        </linearGradient>
                        <linearGradient id="gGreen" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#10b981"/>
                            <stop offset="100%" stop-color="#059669"/>
                        </linearGradient>
                        <linearGradient id="gViolet" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#a78bfa"/>
                            <stop offset="100%" stop-color="#8b5cf6"/>
                        </linearGradient>
                        <linearGradient id="gAmber" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#fbbf24"/>
                            <stop offset="100%" stop-color="#f59e0b"/>
                        </linearGradient>
                        <linearGradient id="gBar1" x1="0%" y1="100%" x2="0%" y2="0%">
                            <stop offset="0%" stop-color="#4f46e5"/>
                            <stop offset="100%" stop-color="#818cf8"/>
                        </linearGradient>
                        <linearGradient id="gBar2" x1="0%" y1="100%" x2="0%" y2="0%">
                            <stop offset="0%" stop-color="#06b6d4"/>
                            <stop offset="100%" stop-color="#67e8f9"/>
                        </linearGradient>
                        <linearGradient id="gBar3" x1="0%" y1="100%" x2="0%" y2="0%">
                            <stop offset="0%" stop-color="#10b981"/>
                            <stop offset="100%" stop-color="#6ee7b7"/>
                        </linearGradient>
                        <linearGradient id="gProgress" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%"   stop-color="#6366f1"/>
                            <stop offset="50%"  stop-color="#06b6d4"/>
                            <stop offset="100%" stop-color="#10b981"/>
                        </linearGradient>
                        <filter id="glow">
                            <feGaussianBlur stdDeviation="2.5" result="blur"/>
                            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                        </filter>
                        <filter id="shadow">
                            <feDropShadow dx="0" dy="10" stdDeviation="18" flood-color="rgba(0,0,0,.45)"/>
                        </filter>
                    </defs>

                    <!-- ── Background rings ── -->
                    <circle cx="270" cy="142" r="200" fill="none" stroke="rgba(99,102,241,.06)" stroke-width="1.2"/>
                    <circle cx="270" cy="142" r="168" fill="none" stroke="rgba(99,102,241,.05)" stroke-width="1"/>

                    <!-- ── Main dashboard card ── -->
                    <rect x="108" y="14" width="324" height="210" rx="18"
                          fill="url(#gCard)" stroke="rgba(255,255,255,.12)" stroke-width="1"
                          filter="url(#shadow)"/>

                    <!-- card header -->
                    <rect x="108" y="14" width="324" height="44" rx="18" fill="rgba(255,255,255,.07)"/>
                    <rect x="108" y="40" width="324" height="18" fill="rgba(255,255,255,.07)"/>
                    <!-- window dots -->
                    <circle cx="130" cy="36" r="4.5" fill="#ef4444" opacity=".75"/>
                    <circle cx="146" cy="36" r="4.5" fill="#f59e0b" opacity=".75"/>
                    <circle cx="162" cy="36" r="4.5" fill="#10b981" opacity=".75"/>
                    <!-- title bar -->
                    <rect x="178" y="32" width="92" height="8" rx="4" fill="rgba(255,255,255,.22)"/>
                    <!-- online pill -->
                    <circle cx="393" cy="36" r="3.5" fill="#10b981"/>
                    <rect x="400" y="32" width="22" height="8" rx="4" fill="rgba(16,185,129,.35)"/>

                    <!-- ── Stat cards row ── -->
                    <!-- Stat 1: Students -->
                    <rect x="120" y="68" width="68" height="52" rx="10"
                          fill="rgba(99,102,241,.18)" stroke="rgba(99,102,241,.28)" stroke-width=".8"/>
                    <rect x="129" y="76" width="14" height="14" rx="4" fill="url(#gIndigo)" opacity=".9"/>
                    <rect x="129" y="95" width="48" height="8"  rx="4" fill="rgba(255,255,255,.45)"/>
                    <rect x="129" y="107" width="32" height="5" rx="2.5" fill="rgba(255,255,255,.18)"/>

                    <!-- Stat 2: Lessons -->
                    <rect x="198" y="68" width="68" height="52" rx="10"
                          fill="rgba(6,182,212,.13)" stroke="rgba(6,182,212,.23)" stroke-width=".8"/>
                    <rect x="207" y="76" width="14" height="14" rx="4" fill="url(#gCyan)" opacity=".9"/>
                    <rect x="207" y="95" width="48" height="8"  rx="4" fill="rgba(255,255,255,.45)"/>
                    <rect x="207" y="107" width="32" height="5" rx="2.5" fill="rgba(255,255,255,.18)"/>

                    <!-- Stat 3: Score -->
                    <rect x="276" y="68" width="68" height="52" rx="10"
                          fill="rgba(16,185,129,.13)" stroke="rgba(16,185,129,.23)" stroke-width=".8"/>
                    <rect x="285" y="76" width="14" height="14" rx="4" fill="url(#gGreen)" opacity=".9"/>
                    <rect x="285" y="95" width="48" height="8"  rx="4" fill="rgba(255,255,255,.45)"/>
                    <rect x="285" y="107" width="32" height="5" rx="2.5" fill="rgba(255,255,255,.18)"/>

                    <!-- Stat 4: AI -->
