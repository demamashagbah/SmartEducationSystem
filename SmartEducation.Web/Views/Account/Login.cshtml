<!-- Scripts -->
<script src="~/assets/vendor/libs/jquery/jquery.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.js"></script>

<script>
    function togglePwd() {
        var inp = document.getElementById('Password');
        var ico = document.getElementById('eyeIcon');
        if (inp.type === 'password') {
            inp.type = 'text';
            ico.className = 'bx bx-hide';
        } else {
            inp.type = 'password';
            ico.className = 'bx bx-show';
        }
    }

    document.getElementById('loginForm').addEventListener('submit', function () {
        var email = document.getElementById('Email').value.trim();
        var pwd   = document.getElementById('Password').value.trim();
        if (email && pwd) {
            document.getElementById('submitBtn').classList.add('loading');
        }
    });

    @if (hasErrors)
    {
        <text>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                icon: 'error',
                title: 'Sign In Failed',
                text: @Json.Serialize(firstError),
                confirmButtonText: 'Try Again',
                confirmButtonColor: '#4f46e5',
                background: '#1e1b4b',
                color: '#e2e8f0',
                iconColor: '#ef4444',
                borderRadius: '16px',
                customClass: {
                    popup:         'swal-edu',
                    confirmButton: 'swal-edu-btn'
                }
            });
        });
        </text>
    }
</script>

<style>
    .swal-edu         { border: 1px solid rgba(255,255,255,.1) !important; border-radius: 16px !important; }
    .swal-edu-btn     { font-family: 'Poppins', sans-serif !important; font-weight: 600 !important; padding: .6rem 1.8rem !important; border-radius: 9px !important; }
</style>

